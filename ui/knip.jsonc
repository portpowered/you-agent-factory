{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main.tsx",
    "src/**/*.test.{ts,tsx,mjs}",
    "src/**/*.stories.tsx",
    "src/testing/vitest.setup.ts",
    "src/testing/guarded-suite-console.setup.ts",
    "integration/**/*.test.mjs",
    "vitest.storybook.config.ts",
    "vite.config.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "integration/**/*.mjs",
    "scripts/**/*.{ts,mjs}",
    "*.{ts,tsx,mjs}",
    "!src/api/generated/**",
    "!fallback_dist/**"
  ],
  "ignore": [
    "src/api/generated/**",
    "fallback_dist/**",
    "scripts/release-dashboard-smoke.mjs",
    "src/types/elkjs-bundled.d.ts",
    "src/vite-env.d.ts"
  ],
  "ignoreExportsUsedInFile": true
}
