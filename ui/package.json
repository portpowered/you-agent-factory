{
  "name": "agent-factory-dashboard-ui",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.3.12",
  "type": "module",
  "scripts": {
    "build-storybook": "storybook build --loglevel warn",
    "build": "tsc -b && vite build && node scripts/normalize-dist-output.mjs",
    "capture:heap-snapshot": "node scripts/capture-heap-snapshot.mjs",
    "check:feature-root-files": "node scripts/check-feature-root-files.mjs",
    "check:inline-component-class-usage": "node scripts/check-inline-component-class-usage.mjs",
    "check:semantic-colors": "bun scripts/check-semantic-color-tokens.ts",
    "check:localized-copy": "bun scripts/check-hardcoded-ui-copy.ts",
    "check:work-outcome-memory": "bun scripts/check-work-outcome-memory.ts",
    "check": "biome check . && bun run check:semantic-colors && node scripts/check-tailwind-spacing-tokens.mjs && node scripts/check-feature-root-files.mjs && node scripts/check-button-usage.mjs && bun run check:inline-component-class-usage",
    "deadcode": "bun scripts/check-deadcode-baseline.ts",
    "dev": "vite",
    "format": "biome format --write .",
    "generate-api": "openapi-typescript ../api/openapi.yaml -o src/api/generated/openapi.ts",
    "lint": "biome lint . && bun run check:localized-copy && bun run check:semantic-colors && node scripts/check-tailwind-spacing-tokens.mjs && node scripts/check-feature-root-files.mjs && node scripts/check-button-usage.mjs && bun run check:inline-component-class-usage",
    "loadtest:agent-fails-memory": "bun scripts/loadtest-agent-fails-memory.ts",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "replay:coverage": "bun scripts/write-replay-coverage-report.ts",
    "replay:coverage:check": "bun scripts/write-replay-coverage-report.ts --check",
    "storybook": "storybook dev -p 6007",
    "storybook:responsive-check": "node scripts/run-storybook-responsive-check.mjs",
    "storybook:serve-static": "http-server storybook-static -p 6008 -a 127.0.0.1 -s",
    "storybook:wait-for-index": "wait-on --timeout 30000 http://127.0.0.1:6008/index.json",
    "storybook:test-runner:ci": "vitest run --config vitest.storybook.config.ts --project=storybook",
    "test:coverage": "node scripts/run-ui-coverage-with-timings.mjs",
    "test:integration": "vitest run integration --no-file-parallelism --maxWorkers 1",
    "test:unit": "node scripts/run-bun-unit.mjs",
    "test": "node scripts/run-bun-unit.mjs && vitest run integration --no-file-parallelism --maxWorkers 1",
    "test-storybook": "bun scripts/run-storybook-ci.mjs",
    "tsc": "tsc -b --noEmit --pretty false"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.2",
    "@xyflow/react": "^12.10.2",
    "d3": "^7.9.0",
    "elkjs": "^0.11.1",
    "lucide-react": "^1.16.0",
    "monaco-editor": "^0.55.1",
    "react": "^19.0.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.0.0",
    "react-grid-layout": "^2.2.3",
    "react-resizable-panels": "^4.10.0",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@storybook/addon-vitest": "^10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/d3": "^7.4.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "@vitest/browser": "4.1.3",
    "@vitest/browser-playwright": "4.1.3",
    "@vitest/coverage-v8": "4.1.3",
    "bun-types": "^1.3.14",
    "http-server": "^14.1.1",
    "jest-axe": "^10.0.0",
    "jsdom": "^27.0.1",
    "knip": "6.14.1",
    "openapi-typescript": "^7.10.1",
    "playwright": "^1.58.2",
    "react-is": "^19.2.0",
    "storybook": "^10.3.5",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vite-plugin-monaco-editor": "^1.1.0",
    "vitest": "4.1.3",
    "wait-on": "^9.0.4",
    "yaml": "^2.9.0"
  }
}
