{
  "name": "agent-factory-dashboard-ui",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.3.12",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build-storybook": "storybook build --loglevel warn",
    "build": "bunx --no-install tsc -b && bunx --no-install vite build && node scripts/normalize-dist-output.mjs",
    "capture:heap-snapshot": "node scripts/capture-heap-snapshot.mjs",
    "check:feature-root-files": "node scripts/check-feature-root-files.mjs",
    "check:feature-folder-file-count": "node scripts/check-feature-folder-file-count.mjs",
    "check:feature-boundary": "node scripts/check-feature-boundary.mjs",
    "check:factory-graph-renderer-path": "node scripts/check-factory-graph-renderer-path.mjs",
    "check:shared-ui-boundary": "node scripts/check-shared-ui-boundary.mjs",
    "check:inline-component-class-usage": "node scripts/check-inline-component-class-usage.mjs",
    "check:semantic-colors": "bun scripts/check-semantic-color-tokens.ts",
    "check:localized-copy": "bun scripts/check-hardcoded-ui-copy.ts",
    "check:packaged-factories-boundary": "node scripts/check-packaged-factories-boundary.mjs",
    "check:test-lanes": "node scripts/check-ui-test-lanes.mjs",
    "check:public-package-boundaries": "node scripts/check-public-package-boundaries.mjs",
    "check:work-outcome-memory": "bun scripts/check-work-outcome-memory.ts",
    "check": "biome check . && bun run check:semantic-colors && node scripts/check-tailwind-spacing-tokens.mjs && node scripts/check-feature-root-files.mjs && node scripts/check-feature-folder-file-count.mjs && node scripts/check-feature-boundary.mjs && bun run check:factory-graph-renderer-path && node scripts/check-shared-ui-boundary.mjs && bun run check:test-lanes && bun run check:public-package-boundaries && bun run check:packaged-factories-boundary && node scripts/check-button-usage.mjs && node scripts/check-feature-form-control-usage.mjs && node scripts/check-dashboard-expand-disclosure.mjs && bun run check:inline-component-class-usage",
    "deadcode": "bun scripts/check-deadcode-baseline.ts",
    "dev": "vite",
    "format": "biome format --write .",
    "generate-api": "node ./scripts/generate-openapi-types.mjs ../api/openapi.yaml src/api/generated/openapi.ts",
    "lint": "biome lint . && bun run check:localized-copy && bun run check:semantic-colors && node scripts/check-tailwind-spacing-tokens.mjs && node scripts/check-feature-root-files.mjs && node scripts/check-feature-folder-file-count.mjs && node scripts/check-feature-boundary.mjs && bun run check:factory-graph-renderer-path && node scripts/check-shared-ui-boundary.mjs && bun run check:test-lanes && bun run check:public-package-boundaries && bun run check:packaged-factories-boundary && node scripts/check-button-usage.mjs && node scripts/check-feature-form-control-usage.mjs && node scripts/check-dashboard-expand-disclosure.mjs && bun run check:inline-component-class-usage",
    "link:public-package-dependencies": "node scripts/link-public-package-dependencies.mjs",
    "loadtest:agent-fails-memory": "bun scripts/loadtest-agent-fails-memory.ts",
    "profile:recording-browser": "node scripts/profile-recording-browser.mjs",
    "publish:public-packages": "node scripts/public-package-publish.mjs --action publish",
    "publish:public-packages:prepare": "node scripts/public-package-publish.mjs --action prepare",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "replay:coverage": "bun scripts/write-replay-coverage-report.ts",
    "replay:coverage:check": "bun scripts/write-replay-coverage-report.ts --check",
    "storybook": "storybook dev -p 6007",
    "storybook:choose-file-check": "node scripts/run-choose-file-browser-check.mjs",
    "storybook:prompt-syntax-save-check": "node scripts/run-prompt-syntax-save-browser-check.mjs",
    "storybook:checkbox-consistency-check": "node scripts/run-checkbox-consistency-browser-check.mjs",
    "storybook:current-selection-save-notifications-check": "node scripts/run-current-selection-save-notifications-browser-check.mjs",
    "storybook:factory-graph-toolbar-jitter-check": "bun run build-storybook && node scripts/run-factory-graph-toolbar-jitter-browser-check.mjs",
    "storybook:factory-graph-touch-check": "node scripts/verify-factory-graph-touch-browser.mjs",
    "storybook:factory-emulator-adapter-check": "node scripts/verify-factory-emulator-adapter-browser.mjs",
    "storybook:customer-factory-emulator-demos-check": "node scripts/verify-customer-factory-emulator-demos-browser.mjs",
    "storybook:factory-emulator-acceptance-check": "node scripts/run-factory-emulator-acceptance-browser.mjs",
    "storybook:header-responsive-check": "node scripts/verify-dashboard-header-responsive-browser.mjs",
    "storybook:dashboard-viewport-check": "node scripts/verify-dashboard-viewport-browser.mjs",
    "storybook:factory-graph-visual-group-save-check": "bun run build-storybook && node scripts/run-factory-graph-visual-group-save-browser-check.mjs",
    "storybook:responsive-check": "node scripts/run-storybook-responsive-check.mjs",
    "storybook:serve-static": "http-server storybook-static -p 6008 -a 127.0.0.1 -s",
    "verify:dashboard-form-field-storybook-browser": "node scripts/verify-dashboard-form-field-storybook-browser.mjs",
    "verify:dashboard-widget-bento-layout": "node scripts/verify-dashboard-widget-bento-layout.mjs",
    "storybook:wait-for-index": "wait-on --timeout 30000 http://127.0.0.1:6008/index.json",
    "storybook:test-runner:ci": "vitest run --config vitest.storybook.config.ts --project=storybook",
    "test:coverage": "node scripts/run-ui-coverage-with-timings.mjs",
    "test:classified": "vitest run --config vitest.lanes.config.ts --maxWorkers=2 --retry=0",
    "test:component": "bun scripts/run-component-tests.ts",
    "test:component:bun": "bun scripts/run-bun-component-tests.ts",
    "test:component:vitest": "bun scripts/run-vitest-component-tests.ts",
    "test:unit:bun": "bun scripts/run-bun-unit-tests.ts",
    "test:unit:bun:coverage": "bun scripts/run-bun-unit-tests.ts --coverage --coverage-reporter=lcov --coverage-dir=coverage/bun-unit",
    "test:integration": "bun run build && node scripts/run-ui-integration-with-timings.mjs",
    "test:integration:durable-session-real-backend": "node scripts/run-durable-session-real-backend-integration-with-timings.mjs",
    "test:public-package-release": "vitest run scripts/verify-public-package-release.test.mjs scripts/public-package-publish.test.mjs",
    "test:public-package-retained-memory": "vitest run src/features/timeline/state/timeline/performance/replay-retained-memory.test.ts",
    "test:factory-emulator-adapter-demos": "vitest run src/App.customer-factory-emulator-demos.test.tsx src/features/factory-emulator/state/factory-emulator-instance.test.ts src/features/factory-emulator/state/factory-emulator-isolation.test.ts src/features/factory-emulator/components/factory-emulator-submission.test.tsx src/features/factory-emulator/components/customer-factory-emulator-demos.test.tsx src/features/factory-emulator/components/customer-factory-emulator-demos-submission.test.tsx src/features/factory-emulator/components/customer-factory-emulator-demos-lifecycle.test.tsx",
    "test:model-provider-reference-input": "vitest run scripts/model-provider-reference-input.test.ts",
    "test:performance": "vitest run --environment=node --no-file-parallelism --maxWorkers=1 --retry=0 src/features/factory-graph-editor/lib/layout/performance/factory-graph-layout-performance.test.ts src/features/timeline/state/timeline/performance/replay-retained-memory.test.ts",
    "test:unit": "node scripts/ui-unit-runner.mjs",
    "test": "node scripts/ui-test-runner.mjs",
    "test-storybook": "bun scripts/run-storybook-ci.mjs",
    "test-storybook:browser-checks": "bun scripts/run-storybook-ci.mjs --browser-checks-only",
    "tsc": "bunx --no-install tsc -b --noEmit --pretty false",
    "typecheck": "bunx --no-install tsc -b --noEmit --pretty false",
    "verify:fresh-npm-install": "node scripts/verify-fresh-npm-install.mjs",
    "verify:public-packages": "node scripts/verify-public-package-release.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-compose-refs": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.2",
    "@xyflow/react": "^12.11.2",
    "@xyflow/system": "^0.0.79",
    "@you-agent-factory/client": "workspace:*",
    "@you-agent-factory/factory-emulator": "workspace:*",
    "@you-agent-factory/factory-replay": "workspace:*",
    "@you-agent-factory/factory-visualizers": "workspace:*",
    "cron-parser": "4.9.0",
    "d3": "^7.9.0",
    "elkjs": "^0.11.1",
    "lucide-react": "^1.16.0",
    "monaco-editor": "^0.55.1",
    "react": "^19.0.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.0.0",
    "react-grid-layout": "^2.2.3",
    "react-redux": "^9.3.0",
    "react-resizable": "^3.2.0",
    "react-resizable-panels": "^4.10.0",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "@you-agent-factory/components": "workspace:*",
    "@you-agent-factory/factory-graph": "workspace:*",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@storybook/addon-vitest": "^10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@tailwindcss/node": "^4.2.2",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "1.3.13",
    "@types/d3": "^7.4.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "@vitest/browser": "4.1.3",
    "@vitest/browser-playwright": "4.1.3",
    "@vitest/coverage-v8": "4.1.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "happy-dom": "^20.9.0",
    "http-server": "^14.1.1",
    "jest-axe": "^10.0.0",
    "jsdom": "^27.0.1",
    "knip": "6.14.1",
    "openapi-typescript": "^7.10.1",
    "playwright": "^1.58.2",
    "react-is": "^19.2.0",
    "storybook": "^10.3.5",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vite-plugin-monaco-editor": "^1.1.0",
    "vitest": "4.1.3",
    "wait-on": "^9.0.4",
    "yaml": "^2.9.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.60.1",
    "@rollup/rollup-win32-x64-msvc": "4.60.1",
    "@swc/core-linux-x64-gnu": "1.15.24",
    "@swc/core-win32-x64-msvc": "1.15.24",
    "@tailwindcss/oxide-linux-x64-gnu": "4.2.2",
    "@tailwindcss/oxide-win32-x64-msvc": "4.2.2",
    "lightningcss-linux-x64-gnu": "1.32.0",
    "lightningcss-win32-x64-msvc": "1.32.0"
  }
}
