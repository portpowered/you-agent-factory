{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.portpowered.com/you/contracts/javascript/runtime-manifest.schema.json",
  "title": "JavaScript runtime symbol manifest",
  "description": "Authored installed-runtime symbol metadata for globals, nested namespaces, values, and callable signatures. Semantic integrity checks for paths, parents, and supported surfaces are validated in later schema revisions and family-specific diagnostics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "symbols"
  ],
  "properties": {
    "formatVersion": {
      "description": "The explicitly supported version of this runtime-manifest format.",
      "const": "1.0.0"
    },
    "symbols": {
      "description": "Installed runtime symbols keyed by stable symbol identifiers. Object keys make duplicate symbol IDs structurally unrepresentable.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "https://schemas.portpowered.com/you/contracts/common/documentation.schema.json#/$defs/itemId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/symbol"
      }
    }
  },
  "$defs": {
    "symbolPath": {
      "description": "Dot-delimited installed symbol path from the runtime global scope.",
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9]*(?:[.][a-z][a-zA-Z0-9]*)*$"
    },
    "memberName": {
      "description": "Final segment name of one direct child symbol within a namespace.",
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9]*$"
    },
    "parameterType": {
      "description": "Descriptive installed-runtime parameter type label.",
      "type": "string",
      "enum": [
        "any",
        "array",
        "boolean",
        "function",
        "json-compatible",
        "number",
        "object",
        "string",
        "undefined"
      ]
    },
    "syncReturnType": {
      "description": "Descriptive synchronous return type label.",
      "type": "string",
      "enum": [
        "any",
        "array",
        "boolean",
        "number",
        "object",
        "object-or-undefined",
        "string",
        "undefined"
      ]
    },
    "promiseReturnType": {
      "description": "Descriptive promise resolution type label.",
      "type": "string",
      "enum": [
        "any",
        "array",
        "child-result-object",
        "pipeline-result-array",
        "undefined",
        "void"
      ]
    },
    "parameter": {
      "description": "One ordered callable parameter with required, optional, default, or rest behavior.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "position",
        "required",
        "rest",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "https://schemas.portpowered.com/you/contracts/common/documentation.schema.json#/$defs/itemId"
        },
        "name": {
          "description": "The parameter name exposed in installed-runtime documentation.",
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]*$"
        },
        "position": {
          "description": "Zero-based position in the ordered callable parameter list.",
          "type": "integer",
          "minimum": 0
        },
        "required": {
          "description": "Whether callers must supply a value for this parameter.",
          "type": "boolean"
        },
        "rest": {
          "description": "Whether this parameter collects remaining arguments.",
          "type": "boolean"
        },
        "default": {
          "description": "Serialized default value when the parameter is optional.",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/parameterType"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "required": {
                "const": true
              }
            },
            "required": [
              "required"
            ]
          },
          "then": {
            "not": {
              "required": [
                "default"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "rest": {
                "const": true
              }
            },
            "required": [
              "rest"
            ]
          },
          "then": {
            "properties": {
              "required": {
                "const": false
              }
            },
            "not": {
              "required": [
                "default"
              ]
            }
          }
        }
      ]
    },
    "parameterList": {
      "description": "Ordered callable parameters from first to last position.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/parameter"
      }
    },
    "syncReturn": {
      "description": "Synchronous return metadata for a callable symbol.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "type"
      ],
      "properties": {
        "kind": {
          "const": "sync"
        },
        "type": {
          "$ref": "#/$defs/syncReturnType"
        }
      }
    },
    "promiseReturn": {
      "description": "Promise return metadata for an asynchronous callable symbol.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "type"
      ],
      "properties": {
        "kind": {
          "const": "promise"
        },
        "type": {
          "$ref": "#/$defs/promiseReturnType"
        }
      }
    },
    "returnShape": {
      "description": "Declared callable return shape.",
      "oneOf": [
        {
          "$ref": "#/$defs/syncReturn"
        },
        {
          "$ref": "#/$defs/promiseReturn"
        }
      ]
    },
    "asyncReturnConstraints": {
      "allOf": [
        {
          "if": {
            "properties": {
              "async": {
                "const": true
              }
            },
            "required": [
              "async"
            ]
          },
          "then": {
            "properties": {
              "return": {
                "$ref": "#/$defs/promiseReturn"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "async": {
                "const": false
              }
            },
            "required": [
              "async"
            ]
          },
          "then": {
            "properties": {
              "return": {
                "$ref": "#/$defs/syncReturn"
              }
            }
          }
        }
      ]
    },
    "symbolBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "path",
        "kind",
        "documentation",
        "lifecycle"
      ],
      "properties": {
        "id": {
          "$ref": "https://schemas.portpowered.com/you/contracts/common/documentation.schema.json#/$defs/itemId"
        },
        "name": {
          "description": "The final segment name exposed on the installed runtime object.",
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]*$"
        },
        "path": {
          "$ref": "#/$defs/symbolPath"
        },
        "kind": {
          "description": "The installed symbol shape.",
          "enum": [
            "function",
            "method",
            "namespace",
            "value"
          ]
        },
        "parent": {
          "description": "Stable identifier of the parent namespace symbol when this symbol is nested.",
          "$ref": "https://schemas.portpowered.com/you/contracts/common/documentation.schema.json#/$defs/itemId"
        },
        "members": {
          "description": "Ordered direct child member names declared by a namespace symbol.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/memberName"
          },
          "uniqueItems": true
        },
        "documentation": {
          "$ref": "https://schemas.portpowered.com/you/contracts/common/documentation.schema.json"
        },
        "lifecycle": {
          "$ref": "https://schemas.portpowered.com/you/contracts/common/deprecations.schema.json"
        },
        "async": {
          "description": "Whether the installed callable returns a Promise.",
          "type": "boolean"
        },
        "parameters": {
          "$ref": "#/$defs/parameterList"
        },
        "return": {
          "$ref": "#/$defs/returnShape"
        }
      }
    },
    "rootNamespaceSymbol": {
      "allOf": [
        {
          "$ref": "#/$defs/symbolBase"
        },
        {
          "type": "object",
          "required": [
            "members"
          ],
          "properties": {
            "kind": {
              "const": "namespace"
            },
            "async": false,
            "parameters": false,
            "return": false
          },
          "not": {
            "required": [
              "parent"
            ]
          }
        }
      ]
    },
    "nestedNamespaceSymbol": {
      "allOf": [
        {
          "$ref": "#/$defs/symbolBase"
        },
        {
          "type": "object",
          "required": [
            "parent",
            "members"
          ],
          "properties": {
            "kind": {
              "const": "namespace"
            },
            "async": false,
            "parameters": false,
            "return": false
          }
        }
      ]
    },
    "valueSymbol": {
      "allOf": [
        {
          "$ref": "#/$defs/symbolBase"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "value"
            },
            "async": false,
            "parameters": false,
            "return": false
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "parent"
                ]
              },
              {
                "required": [
                  "members"
                ]
              }
            ]
          }
        }
      ]
    },
    "functionSymbol": {
      "allOf": [
        {
          "$ref": "#/$defs/symbolBase"
        },
        {
          "$ref": "#/$defs/asyncReturnConstraints"
        },
        {
          "type": "object",
          "required": [
            "async",
            "parameters",
            "return"
          ],
          "properties": {
            "kind": {
              "const": "function"
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "parent"
                ]
              },
              {
                "required": [
                  "members"
                ]
              }
            ]
          }
        }
      ]
    },
    "methodSymbol": {
      "allOf": [
        {
          "$ref": "#/$defs/symbolBase"
        },
        {
          "$ref": "#/$defs/asyncReturnConstraints"
        },
        {
          "type": "object",
          "required": [
            "parent",
            "async",
            "parameters",
            "return"
          ],
          "properties": {
            "kind": {
              "const": "method"
            }
          },
          "not": {
            "required": [
              "members"
            ]
          }
        }
      ]
    },
    "symbol": {
      "oneOf": [
        {
          "$ref": "#/$defs/rootNamespaceSymbol"
        },
        {
          "$ref": "#/$defs/nestedNamespaceSymbol"
        },
        {
          "$ref": "#/$defs/valueSymbol"
        },
        {
          "$ref": "#/$defs/functionSymbol"
        },
        {
          "$ref": "#/$defs/methodSymbol"
        }
      ]
    }
  }
}
