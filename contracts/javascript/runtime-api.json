        "formatVersion": "1.0.0",
        "itemId": "javascript.agent.run",
        "documentation": {
          "title": {
            "id": "javascript.agent.run.title",
            "canonicalEnglish": "Agent child dispatch"
          },
          "description": {
            "id": "javascript.agent.run.description",
            "canonicalEnglish": "Dispatches one child agent run from a closed spec object with a required prompt and optional model, preset, or child-scoped permission-bypass fields. skipPermissions is honored only by providers that advertise the capability; unsupported routes fail before dispatch side effects. Returns a promise that resolves to the child result object after policy checks and child_dispatch emission."
          }
        },
        "examples": [
          "await agent.run({ prompt: \"Summarize findings\", label: \"summarize\", preset: \"operator\", skipPermissions: true })"
        ],
