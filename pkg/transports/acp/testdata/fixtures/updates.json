    {
      "name": "session/update preserves usage update size and used tokens",
      "role": "session/update",
      "direction": "outbound",
      "classification": "accepted",
      "input": {"sessionUpdate": "usage_update", "size": 4096, "used": 512},
      "expected": {"Kind": "usage_update", "Content": null, "MessageID": "", "Usage": {"Size": 4096, "Used": 512}, "SessionInfo": null, "ConfigOptions": null}
    },
    {
      "name": "session/update preserves session info title",
      "role": "session/update",
      "direction": "outbound",
      "classification": "accepted",
      "input": {"sessionUpdate": "session_info_update", "title": "Renamed session"},
      "expected": {"Kind": "session_info_update", "Content": null, "MessageID": "", "Usage": null, "SessionInfo": {"Title": "Renamed session", "UpdatedAt": null}, "ConfigOptions": null}
    },
    {
      "name": "session/update preserves an empty config option list",
      "role": "session/update",
      "direction": "outbound",
      "classification": "accepted",
      "input": {"sessionUpdate": "config_option_update", "configOptions": []},
      "expected": {"Kind": "config_option_update", "Content": null, "MessageID": "", "Usage": null, "SessionInfo": null, "ConfigOptions": null}
    },
    {
      "name": "session/update preserves a non-empty config option list",
      "role": "session/update",
      "direction": "outbound",
      "classification": "accepted",
      "input": {
        "sessionUpdate": "config_option_update",
        "configOptions": [
          {"type": "boolean", "id": "verbose_output", "name": "Verbose output", "currentValue": true}
        ]
      },
      "expected": {
        "Kind": "config_option_update", "Content": null, "MessageID": "", "Usage": null, "SessionInfo": null,
        "ConfigOptions": [
          {"type": "boolean", "id": "verbose_output", "name": "Verbose output", "currentValue": true}
        ]
      }
    },
    {
      "name": "session/update rejects a tool call as a declared no-output scope cut",
      "role": "session/update",
      "direction": "outbound",
      "classification": "rejected",
      "input": {"sessionUpdate": "tool_call", "toolCallId": "tool_synthetic_0001", "title": "Synthetic tool"},
      "expected": {
        "code": -32602,
        "message": "Invalid params",
        "data": {"reason": "unsupported_update"}
      }
    },
    {
      "name": "session/update rejects a plan as a declared no-output scope cut",
