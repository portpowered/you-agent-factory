{
  "cases": [
    {
      "name": "session/update accepts a user message chunk",
      "role": "session/update",
      "direction": "outbound",
      "classification": "accepted",
      "input": {
        "sessionUpdate": "user_message_chunk",
        "content": {"type": "text", "text": "hello"},
        "messageId": "msg_synthetic_0001"
      },
      "expected": {
        "Kind": "user_message_chunk",
        "Content": {"Text": "hello"},
        "MessageID": "msg_synthetic_0001",
        "Usage": null, "SessionInfo": null, "ConfigOptions": null
      }
    },
    {
      "name": "session/update accepts an agent message chunk",
      "role": "session/update",
      "direction": "outbound",
      "classification": "accepted",
      "input": {
        "sessionUpdate": "agent_message_chunk",
        "content": {"type": "text", "text": "working on it"}
      },
      "expected": {
        "Kind": "agent_message_chunk",
        "Content": {"Text": "working on it"},
        "MessageID": "",
        "Usage": null, "SessionInfo": null, "ConfigOptions": null
      }
    },
    {
