    "you.session.show": {
      "id": "you.session.show",
      "name": "show",
      "path": "you session show",
      "aliases": [],
      "documentation": {
        "documentation": {
          "title": {
            "canonicalEnglish": "Show one live factory session"
          },
          "description": {
            "canonicalEnglish": "Show one live factory session from GET /factory-sessions/{session_id}.\n\nHuman output uses FactorySession as the canonical runtime noun and prints orchestrator kind plus Petri or JavaScript runtime projections. Dynamic workflow wording appears only as JavaScript shorthand. Omit session-id to target the default compatibility session (~default). Use global --json for the API-shaped FactorySession payload and global --server to target the same factory API base URI as work list and factory query."
          }
        },
        "examples": [
          "you session show",
          "you session show session-beta",
          "you --json session show session-beta"
        ]
      },
      "visibility": "visible",
      "runnable": true,
      "usage": {
        "line": "show [session-id]",
        "example": "  # Show the default compatibility factory session.\n  you session show\n\n  # Show one named live session with orchestrator-aware runtime fields.\n  you session show session-beta\n\n  # Emit API-shaped JSON for automation.\n  you --json session show session-beta"
      },
