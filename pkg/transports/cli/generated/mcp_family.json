    "you.mcp.serve": {
      "id": "you.mcp.serve",
      "name": "serve",
      "path": "you mcp serve",
      "aliases": [],
      "documentation": {
        "documentation": {
          "title": {
            "canonicalEnglish": "Start the Factory Session MCP stdio server"
          },
          "description": {
            "canonicalEnglish": "Start the dynamic workflow Factory Session MCP server over stdio.\n\nHosts launch this command as a child process and communicate through newline-delimited JSON-RPC on stdin and stdout. The default backing service is the deterministic durable session fixture catalog used by workflow CLI commands.\n\nUse --runtime to select the shared durable JavaScript runtime execution service instead of the fixture catalog. Runtime mode requires workflow sources to resolve from the MCP host working directory or an explicit --project-root.\n\nSet the MCP host working directory to the project root where workflow sources and the fixture catalog resolve. See `you docs mcp` for host configuration, serve modes, smoke, and troubleshooting."
          }
        },
        "examples": [
          "you mcp serve",
          "you mcp serve --fixture-catalog ./pkg/transports/http/testdata/durable-session-contract-fixtures.json",
          "you mcp serve --runtime"
        ]
      },
      "visibility": "visible",
      "runnable": true,
      "usage": {
        "line": "serve",
        "example": "  # Typical MCP host child-process launch.\n  you mcp serve\n\n  # Explicit fixture catalog for offline smoke outside the repository root.\n  you mcp serve --fixture-catalog ./pkg/transports/http/testdata/durable-session-contract-fixtures.json\n\n  # Runtime-backed serve against live durable JavaScript execution.\n  you mcp serve --runtime"
      },
