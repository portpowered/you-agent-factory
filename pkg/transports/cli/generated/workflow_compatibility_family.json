    "you.workflow.preview": {
      "id": "you.workflow.preview",
      "name": "preview",
      "path": "you workflow preview",
      "aliases": [],
      "documentation": {
        "documentation": {
          "title": {
            "canonicalEnglish": "Compatibility preview of workflow validation and policy"
          },
          "description": {
            "canonicalEnglish": "Compatibility command for the Factory preview contract. Resolve workflow source, validate it without execution, and print source, loader, policy, and result-shape diagnostics. Prefer you workflow validate for CLI source checks before Factory Session execution."
          }
        },
        "examples": [
          "you workflow preview --kind WORKFLOW_NAME --value review",
          "you workflow preview --kind INLINE_WORKFLOW --inline \"phase('setup');\""
        ]
      },
      "visibility": "visible",
      "runnable": true,
      "usage": {
        "line": "preview",
        "example": "  # Preview a project workflow by name.\n  you workflow preview --kind WORKFLOW_NAME --value review\n\n  # Preview inline workflow source.\n  you workflow preview --kind INLINE_WORKFLOW --inline \"phase('setup');\""
