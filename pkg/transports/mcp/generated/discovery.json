{
  "formatVersion": "1.0.0",
  "tools": {
    "mcp.tool.you.factory_session.control": {
      "id": "mcp.tool.you.factory_session.control",
      "name": "you.factory_session.control",
      "description": "Apply one durable Factory Session lifecycle control such as approve, pause, resume, cancel, terminate, or retry-dispatch. Maps to POST /factory-sessions/{session_id}/{control}.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "approvalPreviewId": {
            "type": "string"
          },
          "approvedPolicy": {
            "additionalProperties": true,
            "type": "object"
          },
          "dispatchId": {
            "type": "string"
          },
          "operation": {
            "enum": [
              "APPROVE",
              "PAUSE",
              "RESUME",
              "CANCEL",
              "TERMINATE",
              "RETRY_DISPATCH"
            ],
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "sessionId": {
            "type": "string"
          }
        },
        "required": [
          "sessionId",
          "operation"
        ],
        "type": "object"
      }
    },
    "mcp.tool.you.factory_session.get": {
      "id": "mcp.tool.you.factory_session.get",
      "name": "you.factory_session.get",
      "description": "Get one durable Factory Session inspection read model with lifecycle status, source identity, phase, progress, and result summary. Maps to GET /factory-sessions/{session_id}.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "sessionId": {
            "type": "string"
          }
        },
        "required": [
          "sessionId"
        ],
        "type": "object"
      }
    },
    "mcp.tool.you.factory_session.get_result": {
      "id": "mcp.tool.you.factory_session.get_result",
      "name": "you.factory_session.get_result",
      "description": "Retrieve one durable Factory Session result in final or partial mode with optional artifact metadata. Maps to GET /factory-sessions/{session_id}/results.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "includeArtifacts": {
            "type": "boolean"
          },
          "mode": {
            "enum": [
              "final",
              "partial"
            ],
            "type": "string"
          },
          "sessionId": {
            "type": "string"
          }
        },
        "required": [
          "sessionId"
        ],
        "type": "object"
      }
    },
    "mcp.tool.you.factory_session.list": {
      "id": "mcp.tool.you.factory_session.list",
      "name": "you.factory_session.list",
      "description": "List Factory Sessions for one scope (live workspace, persisted durable execution, or all). Uses GET /factory-sessions durable listing vocabulary.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "scope": {
            "enum": [
              "live",
              "persisted",
              "all"
            ],
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "mcp.tool.you.factory_session.list_artifacts": {
      "id": "mcp.tool.you.factory_session.list_artifacts",
      "name": "you.factory_session.list_artifacts",
      "description": "List FactoryArtifact summaries for one Factory Session, including artifact id, kind, visibility, size or hash metadata, and dispatch linkage when available. Maps to GET /factory-sessions/{session_id}/artifacts.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "sessionId": {
            "type": "string"
          }
        },
        "required": [
          "sessionId"
        ],
        "type": "object"
      }
    },
    "mcp.tool.you.factory_session.list_dispatches": {
      "id": "mcp.tool.you.factory_session.list_dispatches",
      "name": "you.factory_session.list_dispatches",
      "description": "List dispatch summaries for one Factory Session, including dispatch id, status, kind, phase, and provider-session correlation metadata when available. Maps to GET /factory-sessions/{session_id}/dispatches.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "phase": {
            "type": "string"
          },
          "sessionId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "sessionId"
        ],
        "type": "object"
      }
    },
    "mcp.tool.you.factory_session.read_events": {
      "id": "mcp.tool.you.factory_session.read_events",
      "name": "you.factory_session.read_events",
      "description": "Read ordered Factory Session event facts for reconnect and inspection without exposing internal Petri-net terminology as the primary public vocabulary. Maps to GET /factory-sessions/{session_id}/events.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "afterEventId": {
            "type": "string"
          },
          "afterSequence": {
            "type": "integer"
          },
          "sessionId": {
            "type": "string"
          }
        },
        "required": [
          "sessionId"
        ],
        "type": "object"
      }
    },
    "mcp.tool.you.factory_session.start_async": {
      "id": "mcp.tool.you.factory_session.start_async",
      "name": "you.factory_session.start_async",
      "description": "Start one async Factory Session and return an accepted or running summary for polling. Maps to POST /factory-sessions/async.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "args": {
            "additionalProperties": true,
            "type": "object"
          },
          "orchestrator": {
            "additionalProperties": true,
            "type": "object"
          },
          "requestId": {
            "type": "string"
          },
          "requestedPolicy": {
            "additionalProperties": true,
            "type": "object"
          },
          "source": {
            "additionalProperties": false,
            "properties": {
              "factoryId": {
                "type": "string"
              },
              "inlineWorkflow": {
                "additionalProperties": true,
                "type": "object"
              },
              "kind": {
                "enum": [
                  "FACTORY_ID",
                  "FACTORY_INLINE",
                  "WORKFLOW_FILE",
                  "WORKFLOW_NAME",
                  "INLINE_WORKFLOW"
                ],
                "type": "string"
              },
              "workflowFile": {
                "type": "string"
              },
              "workflowName": {
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          "wait": {
            "additionalProperties": false,
            "properties": {
              "cancelOnTimeout": {
                "type": "boolean"
              },
              "timeoutMillis": {
                "type": "integer"
              }
            },
            "type": "object"
          }
        },
        "required": [
          "requestId",
          "source"
        ],
        "type": "object"
      }
    },
    "mcp.tool.you.factory_session.start_sync": {
      "id": "mcp.tool.you.factory_session.start_sync",
      "name": "you.factory_session.start_sync",
      "description": "Start one sync Factory Session and wait for terminal completion or timeout. Maps to POST /factory-sessions/sync.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "args": {
            "additionalProperties": true,
            "type": "object"
          },
          "orchestrator": {
            "additionalProperties": true,
            "type": "object"
          },
          "requestId": {
            "type": "string"
          },
          "requestedPolicy": {
            "additionalProperties": true,
            "type": "object"
          },
          "source": {
            "additionalProperties": false,
            "properties": {
              "factoryId": {
                "type": "string"
              },
              "inlineWorkflow": {
                "additionalProperties": true,
                "type": "object"
              },
              "kind": {
                "enum": [
                  "FACTORY_ID",
                  "FACTORY_INLINE",
                  "WORKFLOW_FILE",
                  "WORKFLOW_NAME",
                  "INLINE_WORKFLOW"
                ],
                "type": "string"
              },
              "workflowFile": {
                "type": "string"
              },
              "workflowName": {
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          "wait": {
            "additionalProperties": false,
            "properties": {
              "cancelOnTimeout": {
                "type": "boolean"
              },
              "timeoutMillis": {
                "type": "integer"
              }
            },
            "type": "object"
          }
        },
        "required": [
          "requestId",
          "source"
        ],
        "type": "object"
      }
    },
    "mcp.tool.you.factory_session.validate_source": {
      "id": "mcp.tool.you.factory_session.validate_source",
      "name": "you.factory_session.validate_source",
      "description": "Validate JavaScript orchestrator factory source through the canonical Factory preview contract (POST /factories/preview) before starting a Factory Session.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "allowFactoryLookup": {
            "type": "boolean"
          },
          "argsSchema": {
            "additionalProperties": true,
            "type": "object"
          },
          "artifactRoot": {
            "type": "string"
          },
          "defaultPolicy": {
            "additionalProperties": true,
            "type": "object"
          },
          "inlineSource": {
            "type": "string"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object"
          },
          "projectRoot": {
            "type": "string"
          },
          "requestedPolicy": {
            "additionalProperties": true,
            "type": "object"
          },
          "sourceKind": {
            "enum": [
              "FACTORY_ID",
              "FACTORY_INLINE",
              "WORKFLOW_FILE",
              "WORKFLOW_NAME",
              "INLINE_WORKFLOW"
            ],
            "type": "string"
          },
          "sourceValue": {
            "type": "string"
          }
        },
        "required": [
          "sourceKind"
        ],
        "type": "object"
      }
    },
    "mcp.tool.you.subagent": {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": true,
        "readOnlyHint": false
      },
      "id": "mcp.tool.you.subagent",
      "name": "you.subagent",
      "description": "Start a direct subagent (START, default), or LIST, READ, CONTROL, MESSAGE and REVIVE Worker Sessions on the selected --server host. RUN returns a migration error. START and REVIVE return admission without waiting. MESSAGE requires current execution credentials and preserves durable host delivery facts.",
      "inputSchema": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "action": {
                "enum": [
                  "START",
                  "RUN"
                ],
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "prompt": {
                "minLength": 1,
                "type": "string"
              },
              "provider": {
                "type": "string"
              },
              "reasoningEffort": {
                "type": "string"
              },
              "requestId": {
                "minLength": 1,
                "type": "string"
              },
              "timeoutMillis": {
                "maximum": 9223372036854,
                "minimum": 1,
                "type": "integer"
              },
              "workerSessionId": {
                "minLength": 1,
                "type": "string"
              },
              "workingRoot": {
                "type": "string"
              }
            },
            "required": [
              "prompt"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "action": {
                "enum": [
                  "LIST"
                ],
                "type": "string"
              },
              "history": {
                "default": "all",
                "enum": [
                  "active",
                  "all",
                  "archived"
                ],
                "type": "string"
              },
              "limit": {
                "minimum": 1,
                "type": "integer"
              },
              "nextToken": {
                "minLength": 1,
                "type": "string"
              },
              "scope": {
                "enum": [
                  "direct",
                  "factory",
                  "all"
                ],
                "type": "string"
              },
              "state": {
                "items": {
                  "enum": [
                    "RESERVED",
                    "STARTING",
                    "RUNNING",
                    "PAUSED",
                    "COMPLETED",
                    "FAILED",
                    "CANCELED",
                    "TERMINATED"
                  ],
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "action"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "action": {
                "enum": [
                  "READ"
                ],
                "type": "string"
              },
              "limit": {
                "default": 100,
                "maximum": 1000,
                "minimum": 1,
                "type": "integer"
              },
              "nextToken": {
                "minLength": 1,
                "type": "string"
              },
              "view": {
                "default": "summary",
                "enum": [
                  "summary",
                  "transcript",
                  "events",
                  "logs"
                ],
                "type": "string"
              },
              "workerSessionId": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "action",
              "workerSessionId"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "action": {
                "enum": [
                  "CONTROL"
                ],
                "type": "string"
              },
              "expectedAttemptId": {
                "minLength": 1,
                "type": "string"
              },
              "operation": {
                "enum": [
                  "CANCEL",
                  "TERMINATE",
                  "INTERRUPT",
                  "KILL"
                ],
                "type": "string"
              },
              "replacementMessage": {
                "minLength": 1,
                "type": "string"
              },
              "requestId": {
                "minLength": 1,
                "type": "string"
              },
              "resumeMode": {
                "default": "provider",
                "enum": [
                  "provider",
                  "recorded"
                ],
                "type": "string"
              },
              "successorWorkerSessionId": {
                "minLength": 1,
                "type": "string"
              },
              "workerSessionId": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "action",
              "workerSessionId",
              "operation"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "oneOf": [
              {
                "not": {
                  "required": [
                    "inReplyTo"
                  ]
                },
                "required": [
                  "workerSessionId"
                ]
              },
              {
                "not": {
                  "required": [
                    "workerSessionId"
                  ]
                },
                "required": [
                  "inReplyTo"
                ]
              }
            ],
            "properties": {
              "action": {
                "const": "MESSAGE",
                "type": "string"
              },
              "bodySecret": {
                "default": false,
                "type": "boolean"
              },
              "correlation": {
                "additionalProperties": false,
                "properties": {
                  "factorySessionId": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "workId": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "delivery": {
                "default": "QUEUE",
                "enum": [
                  "QUEUE",
                  "INTERRUPT"
                ],
                "type": "string"
              },
              "expiresInSeconds": {
                "default": 86400,
                "maximum": 604800,
                "minimum": 60,
                "type": "integer"
              },
              "factorySessionId": {
                "minLength": 1,
                "type": "string"
              },
              "ifEnded": {
                "enum": [
                  "REVIVE",
                  "HOLD"
                ],
                "type": "string"
              },
              "inReplyTo": {
                "minLength": 1,
                "type": "string"
              },
              "message": {
                "maxLength": 8192,
                "minLength": 1,
                "type": "string"
              },
              "replyIfEnded": {
                "enum": [
                  "REVIVE",
                  "HOLD"
                ],
                "type": "string"
              },
              "requestId": {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              "workerSessionId": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "action",
              "message",
              "requestId"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "action": {
                "const": "LIST",
                "type": "string"
              },
              "correlationFactorySessionId": {
                "minLength": 1,
                "type": "string"
              },
              "correlationWorkId": {
                "minLength": 1,
                "type": "string"
              },
              "factorySessionId": {
                "minLength": 1,
                "type": "string"
              },
              "fromWorkerSessionId": {
                "minLength": 1,
                "type": "string"
              },
              "markRead": {
                "default": false,
                "type": "boolean"
              },
              "maxResults": {
                "default": 100,
                "maximum": 500,
                "minimum": 1,
                "type": "integer"
              },
              "messages": {
                "const": true,
                "type": "boolean"
              },
              "nextToken": {
                "minLength": 1,
                "type": "string"
              },
              "status": {
                "items": {
                  "enum": [
                    "QUEUED",
                    "READ",
                    "DELIVERED_REVIVE",
                    "REPLIED",
                    "EXPIRED"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              "threadId": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "action",
              "messages"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "action": {
                "const": "READ",
                "type": "string"
              },
              "factorySessionId": {
                "minLength": 1,
                "type": "string"
              },
              "markRead": {
                "default": false,
                "type": "boolean"
              },
              "maxResults": {
                "default": 100,
                "maximum": 500,
                "minimum": 1,
                "type": "integer"
              },
              "messages": {
                "const": true,
                "type": "boolean"
              },
              "nextToken": {
                "minLength": 1,
                "type": "string"
              },
              "status": {
                "items": {
                  "enum": [
                    "QUEUED",
                    "READ",
                    "DELIVERED_REVIVE",
                    "REPLIED",
                    "EXPIRED"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              "threadId": {
                "minLength": 1,
                "type": "string"
              },
              "workerSessionId": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "action",
              "messages",
              "workerSessionId"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "action": {
                "const": "REVIVE",
                "type": "string"
              },
              "factorySessionId": {
                "minLength": 1,
                "type": "string"
              },
              "message": {
                "minLength": 1,
                "type": "string"
              },
              "requestId": {
                "minLength": 1,
                "type": "string"
              },
              "successorWorkerSessionId": {
                "minLength": 1,
                "type": "string"
              },
              "workerSessionId": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "action",
              "workerSessionId",
              "message",
              "requestId",
              "successorWorkerSessionId"
            ],
            "type": "object"
          }
        ],
        "properties": {
          "action": {
            "default": "START",
            "enum": [
              "START",
              "RUN",
              "LIST",
              "READ",
              "CONTROL",
              "MESSAGE",
              "REVIVE"
            ],
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  }
}
