{
  "cases": [
    {
      "name": "local_file_ok",
      "setup": "local_file",
      "fileContent": "png",
      "expect": {
        "outcome": "success",
        "sameAsLocalPath": true
      }
    },
    {
      "name": "local_missing",
      "url": "file:///tmp/infinite-you-workcontent-missing-fixture.png",
      "expect": {
        "outcome": "error",
        "errorContains": ["media url not readable"]
      }
    },
    {
      "name": "data_url_png",
      "url": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==",
      "expect": {
        "outcome": "success",
        "tempPrefix": "workcontent-",
        "tempRemovedOnCleanup": true
      }
    },
    {
      "name": "ssrf_loopback",
      "url": "http://127.0.0.1/test.png",
      "expect": {
        "outcome": "error",
        "errorIs": "unsafe",
        "errorContains": ["media url not allowed", "ssrf"]
      }
    },
    {
      "name": "ssrf_metadata",
      "url": "http://169.254.169.254/latest/meta-data/",
      "expect": {
        "outcome": "error",
        "errorIs": "unsafe",
        "errorContains": ["media url not allowed", "ssrf"]
      }
    },
    {
      "name": "remote_ok",
      "setup": "httptest_server",
      "responseBody": "remote-bytes",
      "contentType": "image/png",
      "expect": {
        "outcome": "success",
        "bodyMatch": true,
        "tempPrefix": "workcontent-",
        "tempRemovedOnCleanup": true
      }
    },
    {
      "name": "remote_404",
      "setup": "httptest_server",
      "statusCode": 404,
      "expect": {
        "outcome": "error",
        "errorIs": "inaccessible",
        "errorContains": ["media url inaccessible", "http 404"]
      }
    },
    {
      "name": "remote_exceeds_size",
      "setup": "httptest_server",
      "responseBody": "xxxxxxxxxxxxxxxx",
      "maxBytes": 8,
      "expect": {
        "outcome": "error",
        "errorIs": "inaccessible",
        "errorContains": ["exceeds size limit"]
      }
    },
    {
      "name": "data_url_exceeds_size",
      "url": "data:text/plain;base64,MTIzNDU2Nzg5MDEyMzQ1Njc4OTAxMjM0NTY3ODkw",
      "maxBytes": 8,
      "expect": {
        "outcome": "error",
        "errorIs": "inaccessible",
        "errorContains": ["data exceeds size limit"]
      }
    }
  ]
}
