      "maximumResponseFidelityCapabilities": {
        "nativeStreaming": true,
        "messageDeltas": true,
        "messageSnapshots": true,
        "reasoningSummaries": true,
        "toolLifecycle": true,
        "toolOutputDeltas": true,
        "fileChanges": true,
        "plans": true,
        "usage": true,
        "stableItemIds": true,
        "providerReconnect": true
      },
      "discovery": {
        "executableNames": [
          "example-next"
        ],
        "endpointKinds": [],
        "configurationKeys": []
      }
    }
  ]
}
