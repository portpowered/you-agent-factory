{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "default",
    "rules",
    "output"
  ],
  "properties": {
    "default": {
      "const": false
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "final-blank-line",
        "unclosed-code-block"
      ],
      "properties": {
        "final-blank-line": {
          "const": "error"
        },
        "unclosed-code-block": {
          "const": "error"
        }
      }
    },
    "output": {
      "const": "text"
    }
  }
}
