{
  "cases": [
    {
      "name": "initialize/supported version negotiates the honest P0 profile",
      "role": "initialize",
      "direction": "inbound",
      "classification": "accepted",
      "input": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "initialize",
        "params": {
          "protocolVersion": 1,
          "clientCapabilities": {
            "fs": {"readTextFile": true, "writeTextFile": true},
            "terminal": true
          }
        }
      },
      "expected": {
        "protocolVersion": 1,
        "authMethods": [],
        "agentCapabilities": {
	          "_meta": {"portpowered.infinite-you/attachment-resume": true},
          "auth": {},
          "loadSession": true,
          "mcpCapabilities": {},
          "promptCapabilities": {},
          "sessionCapabilities": {"resume": {}}
        }
      }
    },
    {
      "name": "initialize/unsupported version is rejected before capability negotiation",
      "role": "initialize",
      "direction": "inbound",
      "classification": "rejected",
      "input": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "initialize",
        "params": {"protocolVersion": 999}
      },
      "expected": {
        "code": -32602,
        "message": "Invalid params",
        "data": {
          "reason": "unsupported_protocol_version",
          "requestedVersion": 999,
          "supportedVersion": 1
        }
      }
    }
  ]
