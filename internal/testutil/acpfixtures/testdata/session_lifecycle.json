{
  "cases": [
    {
      "name": "session/new accepts an absolute cwd with additional directories",
      "role": "session/new",
      "direction": "inbound",
      "classification": "accepted",
      "input": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "session/new",
        "params": {
          "cwd": "/workspace/example-factory",
          "additionalDirectories": ["/workspace/example-factory/vendor"],
          "mcpServers": []
        }
      },
      "expected": {
        "Cwd": "/workspace/example-factory",
        "AdditionalDirectories": ["/workspace/example-factory/vendor"]
      }
    },
    {
      "name": "session/new rejects a client-supplied MCP server",
      "role": "session/new",
      "direction": "inbound",
      "classification": "rejected",
      "input": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "session/new",
        "params": {
          "cwd": "/workspace/example-factory",
          "mcpServers": [{"type": "stdio", "name": "synthetic-mcp", "command": "synthetic-mcp-server", "args": [], "env": []}]
        }
      },
      "expected": {
        "code": -32602,
        "message": "Invalid params",
        "data": {"reason": "malformed_request"}
      }
    },
    {
      "name": "session/new rejects a relative cwd",
      "role": "session/new",
      "direction": "inbound",
      "classification": "rejected",
      "input": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "session/new",
        "params": {"cwd": "relative/path", "mcpServers": []}
      },
      "expected": {
        "code": -32602,
        "message": "Invalid params",
        "data": {"reason": "malformed_request"}
      }
    },
    {
      "name": "session/new rejects an omitted mcpServers field even with an otherwise valid cwd",
      "role": "session/new",
      "direction": "inbound",
      "classification": "rejected",
      "input": {
        "jsonrpc": "2.0",
        "id": 4,
        "method": "session/new",
        "params": {"cwd": "/workspace/example-factory"}
      },
      "expected": {
        "code": -32602,
        "message": "Invalid params",
        "data": {"reason": "malformed_request"}
      }
    },
    {
      "name": "session/new rejects a relative additional directory",
      "role": "session/new",
      "direction": "inbound",
      "classification": "rejected",
      "input": {
        "jsonrpc": "2.0",
        "id": 5,
        "method": "session/new",
        "params": {
          "cwd": "/workspace/example-factory",
          "additionalDirectories": ["relative/vendor"],
          "mcpServers": []
        }
      },
      "expected": {
        "code": -32602,
        "message": "Invalid params",
        "data": {"reason": "malformed_request"}
      }
    },
    {
      "name": "session/load accepts a synthetic session id and absolute cwd",
