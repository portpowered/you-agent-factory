    {
      "name": "session/update preserves an empty config option list",
      "role": "session/update",
      "direction": "outbound",
      "classification": "accepted",
      "input": {
        "sessionId": "sess_synthetic_0001",
        "update": {"sessionUpdate": "config_option_update", "configOptions": []}
      },
      "expected": {"SessionID": "sess_synthetic_0001", "Kind": "config_option_update", "Content": null, "MessageID": "", "Usage": null, "SessionInfo": null, "ConfigOptions": null}
