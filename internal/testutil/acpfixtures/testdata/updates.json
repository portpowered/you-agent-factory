      "input": {
        "sessionId": "sess_synthetic_0001",
        "update": {"sessionUpdate": "tool_call", "toolCallId": "tool_synthetic_0001", "title": "Synthetic tool"}
      },
      "expected": {
        "code": -32602,
        "message": "Invalid params",
        "data": {"reason": "unsupported_update"}
      }
    },
