    {
      "name": "session/update preserves a non-empty config option list",
      "role": "session/update",
      "direction": "outbound",
      "classification": "accepted",
      "input": {
        "sessionId": "sess_synthetic_0001",
        "update": {
          "sessionUpdate": "config_option_update",
