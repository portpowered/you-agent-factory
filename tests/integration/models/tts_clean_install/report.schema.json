{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:you-agent-factory:tests:tts-clean-install-probe-report:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "verdict",
    "environment",
    "identities",
    "preflight",
    "commands",
    "journeys",
    "audio",
    "readiness",
    "network",
    "cleanup",
    "criteria",
    "findings"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "verdict": { "enum": ["PASS", "FAIL", "INCONCLUSIVE"] },
    "environment": {
      "type": "object",
      "required": ["platform", "architecture", "roots", "limits"],
      "additionalProperties": true
    },
    "identities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "identity", "path", "bytes", "sha256"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "identity": { "type": "string" },
          "path": { "type": "string" },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "preflight": {
      "type": "object",
      "required": [
        "completedBeforeEffects",
        "childStarts",
        "listenerOpens",
        "networkAttempts",
        "checks"
      ],
      "additionalProperties": false,
      "properties": {
        "completedBeforeEffects": { "type": "boolean" },
        "childStarts": { "type": "integer", "minimum": 0 },
        "listenerOpens": { "type": "integer", "minimum": 0 },
        "networkAttempts": { "type": "integer", "minimum": 0 },
        "checks": { "type": "array" }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "phase",
          "argv",
          "exitCode",
          "startedAt",
          "endedAt",
          "stdoutBytes",
          "stderrBytes",
          "stdoutSha256",
          "stderrSha256",
          "timedOut",
          "cancelled"
        ],
        "additionalProperties": true
      }
    },
    "journeys": {
      "type": "object",
      "required": ["install", "discovery", "cold", "warmOffline", "removal"],
      "properties": {
        "install": { "$ref": "#/$defs/phase" },
        "discovery": { "$ref": "#/$defs/phase" },
        "cold": { "$ref": "#/$defs/phase" },
        "warmOffline": { "$ref": "#/$defs/phase" },
        "removal": { "$ref": "#/$defs/phase" },
        "steps": {
          "type": "array",
          "minItems": 12,
          "items": { "$ref": "#/$defs/journeyStep" }
        }
      },
      "additionalProperties": true
    },
    "audio": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "name",
          "mediaType",
          "bytes",
          "sha256",
          "riffDecoded",
          "durationMillis",
          "nonSilentSamples"
        ],
        "properties": {
          "name": { "type": "string" },
          "mediaType": { "type": "string" },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "riffDecoded": { "type": "boolean" },
          "durationMillis": { "type": "integer", "minimum": 0 },
          "nonSilentSamples": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": true
      }
    },
    "readiness": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "phase",
          "readinessState",
          "lifecycleState",
          "cacheBytes",
          "cacheReused"
        ],
        "properties": {
          "phase": { "type": "string" },
          "readinessState": { "type": "string" },
          "lifecycleState": { "type": "string" },
          "cacheBytes": { "type": "integer", "minimum": 0 },
          "cacheReused": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "network": {
      "type": "object",
      "required": ["policy", "attempts", "warmOfflineAttempts"],
      "properties": {
        "policy": { "enum": ["none", "staged-loopback-and-declared-public-origins"] },
        "attempts": { "type": "integer", "minimum": 0 },
        "warmOfflineAttempts": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "cleanup": {
      "type": "object",
      "required": [
        "ownedProcesses",
        "ownedListeners",
        "ownedRoots",
        "survivingProcesses",
        "survivingListeners",
        "removedRuntimeRoots"
      ],
      "properties": {
        "ownedProcesses": { "type": "integer", "minimum": 0 },
        "ownedListeners": { "type": "integer", "minimum": 0 },
        "ownedRoots": { "type": "integer", "minimum": 0 },
        "survivingProcesses": { "type": "integer", "minimum": 0 },
        "survivingListeners": { "type": "integer", "minimum": 0 },
        "removedRuntimeRoots": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "verdict", "evidence", "unprovenEdge"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "verdict": {
            "enum": ["PASS", "FAIL", "BLOCKED", "INCONCLUSIVE"]
          },
          "evidence": { "type": "array" },
          "unprovenEdge": { "type": ["string", "null"] }
        }
      }
    },
    "findings": { "type": "array" }
  },
  "$defs": {
    "phase": {
      "type": "object",
      "required": ["status", "evidence", "unprovenEdge"],
      "properties": {
        "status": { "enum": ["PASS", "FAIL", "INCONCLUSIVE", "NOT_RUN"] },
        "evidence": { "type": "array" },
        "unprovenEdge": { "type": "string" }
      },
      "additionalProperties": true
    },
    "journeyStep": {
      "type": "object",
      "required": ["name", "status", "evidence"],
      "properties": {
        "name": { "type": "string" },
        "status": { "enum": ["PASS", "FAIL", "INCONCLUSIVE"] },
        "evidence": { "type": "array", "minItems": 1 }
      },
      "additionalProperties": false
    }
  }
}
