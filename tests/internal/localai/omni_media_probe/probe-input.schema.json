{
  "$id": "urn:you-agent-factory:tests:omni-video-corpus-runner-input:v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "build", "dependencies", "corpusInput", "probeRoot", "limits"],
  "properties": {
    "schemaVersion": {"const": "you.localai.omni-video-corpus-runner-input.v2"},
    "runId": {"type": "string", "minLength": 1},
    "build": {"$ref": "#/$defs/buildIdentity"},
    "dependencies": {"type": "object", "additionalProperties": false, "required": ["model", "projector", "backend"], "properties": {"model": {"$ref": "#/$defs/fileIdentity"}, "projector": {"$ref": "#/$defs/fileIdentity"}, "backend": {"$ref": "#/$defs/fileIdentity"}}},
    "corpusInput": {"$ref": "#/$defs/fileIdentity"},
    "probeRoot": {"type": "string", "minLength": 1},
    "limits": {"type": "object", "additionalProperties": false, "required": ["perCallTimeoutSeconds", "maxHeavyProcesses", "maxCompilerTestProcesses", "maxDiskBytes", "maxDownloadBytes", "maxPaidUsd", "maxCalls", "maxRetries", "forbiddenPort", "networkPolicy"], "properties": {"perCallTimeoutSeconds": {"const": 180}, "maxHeavyProcesses": {"const": 1}, "maxCompilerTestProcesses": {"const": 4}, "maxDiskBytes": {"type": "integer", "maximum": 3221225472}, "maxDownloadBytes": {"const": 0}, "maxPaidUsd": {"const": 0}, "maxCalls": {"const": 10}, "maxRetries": {"const": 0}, "forbiddenPort": {"const": 7437}, "networkPolicy": {"const": "declared-local-assets-and-loopback-only"}}}
  },
  "$defs": {
    "buildIdentity": {"type": "object", "additionalProperties": false, "required": ["path", "identity", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "identity": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "fileIdentity": {"type": "object", "additionalProperties": false, "required": ["path", "identity", "bytes", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "identity": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
  }
}
