+// LOCALAI_LLAMACPP_REQUEST_JSON_SCHEMA_FORWARD
+//
+// Decodes one request-scoped `json_schema` metadata value and installs it into the
+// OAI-compat request body. oaicompat_chat_params_parse reads a response schema only
+// from body_json's "json_schema" field, so a schema the Go layer delivers out of band
+// has to land there before that call. This is pure decoding: nothing but the metadata
+// value is inspected, so thinking, sampling, tools, media and USER grammar semantics are
+// untouched and a schema rides the same generic path as any media-bearing request.
+//
+// A value that is not a JSON object is rejected instead of forwarded.
+// oaicompat_chat_params_parse would dump it verbatim, common/chat.cpp would then see a
+// non-object, silently generate no grammar, and the caller would get an unconstrained
+// answer rather than an error. Failures report the reason only: the schema text, its
+// parse position, and the payload excerpt nlohmann embeds in its own message never reach
+// a log line or a client status.
+//
+// Assignment is not a merge, so forwarding the same metadata again reproduces the same
+// body - re-running this is idempotent. Absence is handled by the caller.
+static void llama_grpc_apply_request_json_schema(const std::string & raw, json & body_json) {
+    json schema;
+    try {
+        schema = json::parse(raw);
+    } catch (const json::parse_error &) {
+        // e.what() is deliberately not reported: nlohmann's parse message ends with a
+        // "last read:" excerpt of the payload, which would echo the schema back out.
+        throw std::invalid_argument("request metadata 'json_schema' is not valid JSON");
+    }
+
+    if (!schema.is_object() || schema.empty()) {
+        throw std::invalid_argument("request metadata 'json_schema' must be a nonempty JSON object");
+    }
+
+    body_json["json_schema"] = schema;
 }
 
