package main

import (
    "os"
    "path/filepath"
    "strings"
    "testing"
    "unsafe"

    pb "github.com/mudler/LocalAI/pkg/grpc/proto"
)

func TestFailedNativeGenerationPreservesCauseAndPublishesNoAudio(t *testing.T) {
    oldTTS, oldError, oldFree := CppTTS, CppLastError, CppPCMFree
    t.Cleanup(func() { CppTTS, CppLastError, CppPCMFree = oldTTS, oldError, oldFree })
    samples := []float32{0, 0.25, -0.25}
    fail := true
    CppTTS = func(_ string, _ string, _ string, _ string, _ unsafe.Pointer, _ int, _ string,
        _ int64, _ float32, _ int, _ float32, _ float32, _ int, outN unsafe.Pointer) uintptr {
        if fail { return 0 }
        *(*int32)(outN) = int32(len(samples))
        return uintptr(unsafe.Pointer(&samples[0]))
    }
    CppLastError = func() string { return "generation exhausted max_new_tokens=1 without EOS" }
    CppPCMFree = func(uintptr) {}
    destination := filepath.Join(t.TempDir(), "speech.wav")
    request := &pb.TTSRequest{Text: "Can you assist me?", Dst: destination}
    model := &Qwen3TtsCpp{}
    err := model.TTS(request)
    if err == nil || !strings.Contains(err.Error(), "without EOS") {
        t.Fatalf("failed synthesis = %v, want meaningful native exhaustion", err)
    }
    if _, err := os.Stat(destination); !os.IsNotExist(err) {
        t.Fatalf("failed synthesis destination stat = %v, want unpublished", err)
    }
    fail = false
    if err := model.TTS(request); err != nil { t.Fatalf("next synthesis: %v", err) }
    body, err := os.ReadFile(destination)
    if err != nil || len(body) != 44+2*len(samples) || string(body[:4]) != "RIFF" {
        t.Fatalf("next synthesis WAV bytes=%d error=%v", len(body), err)
    }
}
