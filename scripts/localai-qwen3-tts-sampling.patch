diff --git a/src/sampling.h b/src/sampling.h
--- a/src/sampling.h
+++ b/src/sampling.h
@@ -68,0 +69,17 @@
+}
+
+// Negative infinity is an intentional mask. NaN, positive infinity, and
+// distributions without a finite candidate must never manufacture a token.
+static bool sampling_finite_candidates(const float * logits, int V) {
+    if (!logits || V <= 0) {
+        return false;
+    }
+    bool has_finite = false;
+    for (int i = 0; i < V; i++) {
+        if (std::isfinite(logits[i])) {
+            has_finite = true;
+        } else if (logits[i] != -INFINITY) {
+            return false;
+        }
+    }
+    return has_finite;
