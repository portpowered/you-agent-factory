{
  "$defs": {
    "NameValue": {
      "additionalProperties": false,
      "description": "A customer-facing value with a required base fallback and optional exact locale overrides. Locale tags must use their canonical BCP 47 spelling.",
      "properties": {
        "id": {
          "description": "Optional stable metadata identifier; consumers must not render it as display copy.",
          "type": "string"
        },
        "locales": {
          "description": "Canonical BCP 47 locales for which the base value was authored.",
          "items": {
            "minLength": 2,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "type": {
          "description": "Discriminator for localized customer-facing metadata.",
          "enum": [
            "LOCALIZABLE_ASSET"
          ],
          "type": "string"
        },
        "value": {
          "description": "Required base value returned when no exact locale override exists.",
          "minLength": 1,
          "type": "string"
        },
        "values": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Exact canonical BCP 47 locale tags mapped to localized overrides.",
          "type": "object"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "type": "object"
    },
    "ProviderACPResourceDelivery": {
      "description": "Evidence state for delivering a resource through the ACP harness.",
      "enum": [
        "implemented",
        "unsupported",
        "conditional",
        "unknown"
      ],
      "type": "string"
    },
    "ProviderACPSupport": {
      "additionalProperties": false,
      "description": "Typed ACP support metadata for a provider harness.",
      "oneOf": [
        {
          "properties": {
            "condition": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            "support": {
              "enum": [
                "conditional"
              ],
              "type": "string"
            }
          },
          "required": [
            "condition"
          ],
          "type": "object"
        },
        {
          "properties": {
            "support": {
              "enum": [
                "supported",
                "unsupported",
                "unknown"
              ],
              "type": "string"
            }
          },
          "type": "object"
        }
      ],
      "properties": {
        "condition": {
          "description": "Bounded operator-visible condition required when ACP support is conditional.",
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "evidenceRefs": {
          "description": "Stable IDs of evidence records qualifying ACP support.",
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9._-]*$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "protocolVersion": {
          "description": "ACP protocol version known to the manifest author.",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
          "type": "string"
        },
        "resourceDelivery": {
          "$ref": "#/$defs/ProviderACPResourceDelivery"
        },
        "support": {
          "$ref": "#/$defs/ProviderCapabilitySupport"
        }
      },
      "required": [
        "support"
      ],
      "type": "object"
    },
    "ProviderCapabilityEvidence": {
      "additionalProperties": false,
      "description": "Bounded evidence record qualifying one or more published capability facts.",
      "properties": {
        "factRefs": {
          "description": "Optional bounded references to facts qualified by this record.",
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "harnessVersion": {
          "description": "Optional harness version used when the evidence was checked.",
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "description": "Stable manifest-local evidence identifier.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9._-]*$",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ProviderCapabilityEvidenceKind"
        },
        "url": {
          "description": "Optional public HTTPS source for the evidence.",
          "format": "uri",
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "^https://(?:[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?\\.)+[A-Za-z]{2,}(?::[0-9]+)?(?:[/?#].*)?$",
          "type": "string"
        },
        "verifiedOn": {
          "description": "UTC calendar date on which the evidence was checked.",
          "format": "date",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "verifiedOn"
      ],
      "type": "object"
    },
    "ProviderCapabilityEvidenceKind": {
      "description": "Source class for evidence supporting a published capability fact.",
      "enum": [
        "primary_documentation",
        "protocol_probe",
        "conformance_fixture",
        "maintainer_assertion"
      ],
      "type": "string"
    },
    "ProviderCapabilitySupport": {
      "description": "Evidence state shared by harness, modality, and tool capability facts.",
      "enum": [
        "supported",
        "unsupported",
        "conditional",
        "unknown"
      ],
      "type": "string"
    },
    "ProviderDeprecation": {
      "additionalProperties": false,
      "description": "Coherent metadata for a deprecated provider entry. Presence of this object means the provider is deprecated. replacementProviderId, when present, must name a different canonical provider in the same catalog; it cannot identify the deprecated provider itself.",
      "properties": {
        "deprecatedSince": {
          "description": "UTC calendar date on which the catalog began marking the provider deprecated.",
          "format": "date",
          "type": "string"
        },
        "reason": {
          "allOf": [
            {
              "$ref": "#/$defs/NameValue"
            }
          ],
          "description": "Localizable explanation of why the provider is deprecated."
        },
        "replacementProviderId": {
          "description": "Canonical ID of a different, non-deprecated replacement provider in this catalog.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
          "type": "string"
        }
      },
      "required": [
        "deprecatedSince",
        "reason"
      ],
      "type": "object"
    },
    "ProviderDiscoveryEndpointKind": {
      "description": "Static endpoint transport kind that may be checked without credentials.",
      "enum": [
        "local-http",
        "remote-http",
        "stdio",
        "unix-socket"
      ],
      "type": "string"
    },
    "ProviderDiscoveryPrerequisite": {
      "additionalProperties": false,
      "description": "Sanitized prerequisite guidance that never carries a secret or machine-local value.",
      "properties": {
        "description": {
          "description": "Bounded setup guidance without environment values or paths.",
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "description": "Sanitized prerequisite category.",
          "enum": [
            "executable",
            "authentication",
            "workspace",
            "configuration"
          ],
          "type": "string"
        },
        "name": {
          "description": "Stable prerequisite name, never a secret value.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9._-]*$",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "description"
      ],
      "type": "object"
    },
    "ProviderDiscoveryPrerequisites": {
      "additionalProperties": false,
      "description": "Static, credential-free facts that tooling may use to explain how a provider can be discovered. Only names and endpoint kinds are published: credential values, environment values, endpoint addresses, machine-local paths, installation/readiness state, and pricing are outside this contract.",
      "properties": {
        "configurationKeys": {
          "description": "Required configuration-key names only; configuration and environment values are forbidden.",
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9._-]*$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "endpointKinds": {
          "description": "Credential-free endpoint transport kinds; addresses and live status are not published.",
          "items": {
            "$ref": "#/$defs/ProviderDiscoveryEndpointKind"
          },
          "type": "array",
          "uniqueItems": true
        },
        "executableNames": {
          "description": "Executable basenames that may supply the provider integration.",
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "prerequisites": {
          "description": "Sanitized executable, authentication, workspace, or configuration requirements.",
          "items": {
            "$ref": "#/$defs/ProviderDiscoveryPrerequisite"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "executableNames",
        "endpointKinds",
        "configurationKeys"
      ],
      "type": "object"
    },
    "ProviderDocumentationLink": {
      "additionalProperties": false,
      "description": "One stable public documentation resource for a provider.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ProviderDocumentationLinkKind"
        },
        "url": {
          "description": "Public HTTPS documentation URL with a DNS hostname. Machine-local, IP-address, and credential-bearing URLs are invalid.",
          "format": "uri",
          "minLength": 1,
          "pattern": "^https://(?:[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?\\.)+[A-Za-z]{2,}(?::[0-9]+)?(?:[/?#].*)?$",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "url"
      ],
      "type": "object"
    },
    "ProviderDocumentationLinkKind": {
      "description": "Purpose of one stable public provider documentation link.",
      "enum": [
        "homepage",
        "setup",
        "reference",
        "support"
      ],
      "type": "string"
    },
    "ProviderEffort": {
      "description": "Provider-supported reasoning effort setting for one model.",
      "enum": [
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "type": "string"
    },
    "ProviderExecutionCapabilities": {
      "additionalProperties": false,
      "description": "Maximum evidenced execution features of the provider integration. These values are independent of support posture and do not imply current-machine readiness.",
      "properties": {
        "imageInput": {
          "description": "Accepts image content as invocation input.",
          "type": "boolean"
        },
        "promptSubmission": {
          "description": "Accepts authored prompt input for execution.",
          "type": "boolean"
        },
        "sessionResume": {
          "description": "Can continue an identified provider session.",
          "type": "boolean"
        },
        "structuredOutput": {
          "description": "Can constrain authoritative output using a structured schema.",
          "type": "boolean"
        },
        "toolExecution": {
          "description": "Can execute provider-managed tools during an invocation.",
          "type": "boolean"
        },
        "workingDirectory": {
          "description": "Can execute with an explicit working directory.",
          "type": "boolean"
        },
        "worktree": {
          "description": "Can execute against an isolated source-control worktree.",
          "type": "boolean"
        }
      },
      "required": [
        "promptSubmission",
        "imageInput",
        "sessionResume",
        "structuredOutput",
        "toolExecution",
        "workingDirectory",
        "worktree"
      ],
      "type": "object"
    },
    "ProviderHarness": {
      "additionalProperties": false,
      "description": "Provider harness metadata, kept separate from model capability facts.",
      "properties": {
        "acpSupport": {
          "$ref": "#/$defs/ProviderACPSupport"
        },
        "kind": {
          "$ref": "#/$defs/ProviderHarnessKind"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "ProviderHarnessKind": {
      "description": "Execution harness family represented by a provider manifest.",
      "enum": [
        "native_cli",
        "acp"
      ],
      "type": "string"
    },
    "ProviderImplementationAvailability": {
      "description": "How an implementation is supplied. Availability is publication metadata, not a live readiness or installation result.",
      "enum": [
        "bundled",
        "externally-supplied",
        "catalog-only"
      ],
      "type": "string"
    },
    "ProviderKnownLimit": {
      "additionalProperties": false,
      "description": "Named bounded provider constraint or documented behavior.",
      "properties": {
        "default": {
          "description": "Positive numeric default when kind is default.",
          "format": "int64",
          "minimum": 1,
          "type": "integer"
        },
        "description": {
          "description": "Bounded operator-facing explanation of the limit.",
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ProviderKnownLimitKind"
        },
        "maximum": {
          "description": "Positive numeric maximum when kind is maximum.",
          "format": "int64",
          "minimum": 1,
          "type": "integer"
        },
        "name": {
          "description": "Stable machine-readable limit name.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9._-]*$",
          "type": "string"
        },
        "unit": {
          "description": "Unit or flag domain for the value.",
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "value": {
          "description": "Bounded non-numeric behavior value when kind is behavior.",
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "name",
        "kind",
        "unit",
        "description"
      ],
      "type": "object"
    },
    "ProviderKnownLimitKind": {
      "description": "Meaning of the value recorded by one named provider limit fact.",
      "enum": [
        "maximum",
        "default",
        "behavior"
      ],
      "type": "string"
    },
    "ProviderManifest": {
      "additionalProperties": false,
      "description": "Public, data-only metadata for one model-provider integration. A manifest describes evidenced maximum behavior and publication posture; it never reports current-machine installation, authentication, readiness, pricing, or runtime registration.",
      "properties": {
        "aliases": {
          "description": "Alternate lowercase identifiers; aliases must not equal or shadow any catalog ID or alias.",
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "deprecation": {
          "$ref": "#/$defs/ProviderDeprecation"
        },
        "description": {
          "allOf": [
            {
              "$ref": "#/$defs/NameValue"
            }
          ],
          "description": "Localizable customer-facing provider summary."
        },
        "discovery": {
          "$ref": "#/$defs/ProviderDiscoveryPrerequisites"
        },
        "displayName": {
          "allOf": [
            {
              "$ref": "#/$defs/NameValue"
            }
          ],
          "description": "Localizable customer-facing provider name."
        },
        "documentation": {
          "description": "Stable public documentation links for this provider.",
          "items": {
            "$ref": "#/$defs/ProviderDocumentationLink"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "evidence": {
          "description": "Bounded evidence records used to qualify capability facts in this manifest.",
          "items": {
            "$ref": "#/$defs/ProviderCapabilityEvidence"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "harness": {
          "$ref": "#/$defs/ProviderHarness"
        },
        "harnessRoutes": {
          "description": "Directional routes implemented by the provider harness, independent of any model catalog claim.",
          "items": {
            "$ref": "#/$defs/ProviderModality"
          },
          "maxItems": 32,
          "type": "array"
        },
        "id": {
          "description": "Stable canonical lowercase provider identifier.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
          "type": "string"
        },
        "implementationAvailability": {
          "$ref": "#/$defs/ProviderImplementationAvailability"
        },
        "knownLimits": {
          "description": "Named provider constraints and bounded behavior facts in canonical name order.",
          "items": {
            "$ref": "#/$defs/ProviderKnownLimit"
          },
          "type": "array"
        },
        "maximumExecutionCapabilities": {
          "$ref": "#/$defs/ProviderExecutionCapabilities"
        },
        "maximumResponseFidelityCapabilities": {
          "$ref": "#/$defs/ProviderResponseFidelityCapabilities"
        },
        "modelCatalogPosture": {
          "$ref": "#/$defs/ProviderModelCatalogPosture"
        },
        "models": {
          "description": "Named provider models and their complete capability facts in canonical model-ID order.",
          "items": {
            "$ref": "#/$defs/ProviderModel"
          },
          "type": "array"
        },
        "technicalSupportLevel": {
          "$ref": "#/$defs/ProviderTechnicalSupportLevel"
        },
        "tools": {
          "description": "Named provider tool facts in canonical tool-name order.",
          "items": {
            "$ref": "#/$defs/ProviderTool"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "aliases",
        "displayName",
        "description",
        "documentation",
        "technicalSupportLevel",
        "implementationAvailability",
        "maximumExecutionCapabilities",
        "maximumResponseFidelityCapabilities",
        "discovery"
      ],
      "type": "object"
    },
    "ProviderMediaConstraints": {
      "additionalProperties": false,
      "description": "Optional bounded media constraints for one modality route.",
      "properties": {
        "maxBytes": {
          "description": "Maximum payload size in bytes when documented.",
          "format": "int64",
          "minimum": 1,
          "type": "integer"
        },
        "maxDurationSeconds": {
          "description": "Maximum media duration in seconds when documented.",
          "minimum": 0,
          "type": "number"
        },
        "maxItems": {
          "description": "Maximum number of media items accepted or emitted in one route.",
          "minimum": 1,
          "type": "integer"
        },
        "mediaTypes": {
          "description": "Accepted or emitted media types, such as image/png or audio/wav.",
          "items": {
            "maxLength": 128,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9!#$\u0026^_.+-]+/[A-Za-z0-9!#$\u0026^_.+-]+$",
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "type": "object"
    },
    "ProviderModality": {
      "additionalProperties": false,
      "description": "One explicit directional modality fact for a harness route or model.",
      "oneOf": [
        {
          "properties": {
            "condition": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            "support": {
              "enum": [
                "conditional"
              ],
              "type": "string"
            }
          },
          "required": [
            "condition"
          ],
          "type": "object"
        },
        {
          "properties": {
            "support": {
              "enum": [
                "supported",
                "unsupported",
                "unknown"
              ],
              "type": "string"
            }
          },
          "type": "object"
        }
      ],
      "properties": {
        "condition": {
          "description": "Bounded operator-visible condition required when support is conditional.",
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "direction": {
          "$ref": "#/$defs/ProviderModalityDirection"
        },
        "evidenceRefs": {
          "description": "Stable IDs of evidence records qualifying this fact.",
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9._-]*$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "mediaConstraints": {
          "$ref": "#/$defs/ProviderMediaConstraints"
        },
        "modality": {
          "$ref": "#/$defs/ProviderModalityKind"
        },
        "support": {
          "$ref": "#/$defs/ProviderModalitySupport"
        },
        "transport": {
          "$ref": "#/$defs/ProviderModalityTransport"
        }
      },
      "required": [
        "direction",
        "modality",
        "support",
        "transport"
      ],
      "type": "object"
    },
    "ProviderModalityDirection": {
      "description": "Direction in which a provider model accepts or emits a modality.",
      "enum": [
        "input",
        "output"
      ],
      "type": "string"
    },
    "ProviderModalityKind": {
      "description": "Media or content modality understood by a provider model.",
      "enum": [
        "text",
        "image",
        "audio",
        "video"
      ],
      "type": "string"
    },
    "ProviderModalitySupport": {
      "description": "Evidence state for a directional harness or model modality fact.",
      "enum": [
        "supported",
        "unsupported",
        "conditional",
        "unknown"
      ],
      "type": "string"
    },
    "ProviderModalityTransport": {
      "description": "How a supported modality is supplied or returned.",
      "enum": [
        "inline",
        "file_path",
        "acp_resource",
        "tool_mediated",
        "none"
      ],
      "type": "string"
    },
    "ProviderModel": {
      "additionalProperties": false,
      "description": "Capability facts for one named model exposed by a provider.",
      "properties": {
        "efforts": {
          "description": "Reasoning effort values accepted independently by this model.",
          "items": {
            "$ref": "#/$defs/ProviderEffort"
          },
          "type": "array",
          "uniqueItems": true
        },
        "id": {
          "description": "Exact model identifier accepted by the provider adapter.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        },
        "modalities": {
          "description": "Complete directional modality facts, including unsupported values.",
          "items": {
            "$ref": "#/$defs/ProviderModality"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "efforts",
        "modalities"
      ],
      "type": "object"
    },
    "ProviderModelCatalogPosture": {
      "description": "How a provider's model identifiers are known to the published catalog.",
      "enum": [
        "exact",
        "runtime_discovered",
        "operator_selected",
        "unknown"
      ],
      "type": "string"
    },
    "ProviderResponseFidelityCapabilities": {
      "additionalProperties": false,
      "description": "Maximum evidenced response-event fidelity of the provider integration. Capabilities describe observable output independently of support posture.",
      "properties": {
        "fileChanges": {
          "description": "Emits observed file changes.",
          "type": "boolean"
        },
        "messageDeltas": {
          "description": "Emits incremental assistant-message deltas.",
          "type": "boolean"
        },
        "messageSnapshots": {
          "description": "Emits assistant-message snapshots.",
          "type": "boolean"
        },
        "nativeStreaming": {
          "description": "Exposes native streaming observations.",
          "type": "boolean"
        },
        "plans": {
          "description": "Emits plan updates.",
          "type": "boolean"
        },
        "providerReconnect": {
          "description": "Supports reconnecting an interrupted provider response stream.",
          "type": "boolean"
        },
        "reasoningSummaries": {
          "description": "Emits reasoning summaries or reasoning deltas.",
          "type": "boolean"
        },
        "stableItemIds": {
          "description": "Assigns stable item identifiers across response events.",
          "type": "boolean"
        },
        "toolLifecycle": {
          "description": "Emits correlated tool lifecycle metadata.",
          "type": "boolean"
        },
        "toolOutputDeltas": {
          "description": "Emits incremental tool-output deltas.",
          "type": "boolean"
        },
        "usage": {
          "description": "Emits usage accounting.",
          "type": "boolean"
        }
      },
      "required": [
        "nativeStreaming",
        "messageDeltas",
        "messageSnapshots",
        "reasoningSummaries",
        "toolLifecycle",
        "toolOutputDeltas",
        "fileChanges",
        "plans",
        "usage",
        "stableItemIds",
        "providerReconnect"
      ],
      "type": "object"
    },
    "ProviderTechnicalSupportLevel": {
      "description": "Maintainer-verified technical support posture for a provider integration. This value does not describe whether the provider is installed or ready on the current machine.",
      "enum": [
        "production",
        "experimental",
        "not-supported"
      ],
      "type": "string"
    },
    "ProviderTool": {
      "additionalProperties": false,
      "description": "One named provider tool fact used for execution planning.",
      "oneOf": [
        {
          "properties": {
            "condition": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            "support": {
              "enum": [
                "conditional"
              ],
              "type": "string"
            }
          },
          "required": [
            "condition"
          ],
          "type": "object"
        },
        {
          "properties": {
            "support": {
              "enum": [
                "supported",
                "unsupported",
                "unknown"
              ],
              "type": "string"
            }
          },
          "type": "object"
        }
      ],
      "properties": {
        "availability": {
          "$ref": "#/$defs/ProviderToolAvailability"
        },
        "condition": {
          "description": "Bounded operator-visible condition required when tool support is conditional.",
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "defaultEnabled": {
          "description": "Whether the tool is enabled by default; null means the default is unknown or operator-defined.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "description": {
          "description": "Bounded explanation of the tool fact.",
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "evidenceRefs": {
          "description": "Stable IDs of evidence records qualifying this tool fact.",
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9._-]*$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "name": {
          "description": "Stable provider-neutral tool name.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9._-]*$",
          "type": "string"
        },
        "outputModalities": {
          "description": "Tool-produced modalities, kept separate from direct model output modalities.",
          "items": {
            "$ref": "#/$defs/ProviderToolOutputModality"
          },
          "maxItems": 16,
          "type": "array",
          "uniqueItems": true
        },
        "support": {
          "$ref": "#/$defs/ProviderToolSupport"
        }
      },
      "required": [
        "name",
        "support",
        "description"
      ],
      "type": "object"
    },
    "ProviderToolAvailability": {
      "description": "How a named tool becomes available to the provider harness.",
      "enum": [
        "built_in",
        "optional",
        "operator_configured",
        "external",
        "unknown"
      ],
      "type": "string"
    },
    "ProviderToolOutputModality": {
      "additionalProperties": false,
      "description": "A modality produced by a tool, explicitly separate from direct model output.",
      "oneOf": [
        {
          "properties": {
            "condition": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            "support": {
              "enum": [
                "conditional"
              ],
              "type": "string"
            }
          },
          "required": [
            "condition"
          ],
          "type": "object"
        },
        {
          "properties": {
            "support": {
              "enum": [
                "supported",
                "unsupported",
                "unknown"
              ],
              "type": "string"
            }
          },
          "type": "object"
        }
      ],
      "properties": {
        "condition": {
          "description": "Bounded operator-visible condition required when support is conditional.",
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "evidenceRefs": {
          "description": "Stable IDs of evidence records qualifying this tool output fact.",
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9._-]*$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "mediaConstraints": {
          "$ref": "#/$defs/ProviderMediaConstraints"
        },
        "modality": {
          "$ref": "#/$defs/ProviderModalityKind"
        },
        "support": {
          "$ref": "#/$defs/ProviderCapabilitySupport"
        },
        "transport": {
          "$ref": "#/$defs/ProviderModalityTransport"
        }
      },
      "required": [
        "modality",
        "support",
        "transport"
      ],
      "type": "object"
    },
    "ProviderToolSupport": {
      "description": "Evidence state for a named provider tool fact.",
      "enum": [
        "supported",
        "unsupported",
        "conditional",
        "unknown"
      ],
      "type": "string"
    }
  },
  "$id": "https://schemas.you.dev/model-providers/provider-catalog/1.0.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Versioned public collection of provider manifests.",
  "properties": {
    "formatVersion": {
      "description": "Provider Catalog document format version.",
      "enum": [
        "1.0.0"
      ],
      "type": "string"
    },
    "providerSchema": {
      "description": "Immutable JSON Schema identifier used to validate every provider entry.",
      "enum": [
        "https://schemas.you.dev/model-providers/provider-manifest/1.0.0.schema.json"
      ],
      "format": "uri",
      "type": "string"
    },
    "providers": {
      "description": "Provider manifests in canonical provider-ID order.",
      "items": {
        "$ref": "#/$defs/ProviderManifest"
      },
      "type": "array"
    },
    "publicationProvenance": {
      "additionalProperties": false,
      "description": "Optional source-revision provenance supplied by a publication staging process.",
      "properties": {
        "sourceCommit": {
          "description": "Full immutable Git commit identifying the published source tree.",
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "sourceRepository": {
          "description": "Public source repository from which the catalog was published.",
          "format": "uri",
          "type": "string"
        }
      },
      "required": [
        "sourceRepository",
        "sourceCommit"
      ],
      "type": "object"
    }
  },
  "required": [
    "formatVersion",
    "providerSchema",
    "providers"
  ],
  "type": "object"
}
