        "jsonPath": "workerPresets",
        "defaultEmptyBehavior": "missing workerPresets array is backward compatible and yields an empty preset list",
        "parseOwner": "operator_settings",
        "persistenceOwner": "operator_settings",
        "strictness": "operator_settings generated GlobalConfig strict decode (unknown fields and trailing JSON rejected)",
        "notes": "file-only (no env or flag layers)",
        "documentation": {
          "formatVersion": "1.0.0",
          "itemId": "config.worker-presets",
          "documentation": {
            "title": {
              "id": "config.worker-presets.title",
              "canonicalEnglish": "Worker presets"
            },
            "description": {
              "id": "config.worker-presets.description",
              "canonicalEnglish": "Named worker model presets parsed from file only. Missing array is backward compatible and yields an empty preset list."
            }
          },
          "examples": [
            [
