{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.portpowered.com/you/config/you-config.schema.json",
  "title": "You operator and system configuration",
  "description": "The shared .you-agent-factory/config.json contract owned by the Operator Settings service.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "backendScopeID": {
      "type": "string",
      "description": "Stable identifier for the local provider-backed runtime boundary owned by operator_settings.",
      "examples": [
        "local-aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee"
      ]
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "description": "Operator defaults parsed by operator_settings from file before env/flag resolution.",
      "examples": [
        {
          "workerModelProvider": "claude",
          "workerModel": "claude-sonnet"
        }
      ],
      "properties": {
        "workerModelProvider": {
          "type": "string",
          "description": "Default worker model provider resolved through file, environment, and flag precedence.",
          "examples": [
            "claude",
            "codex",
            "openai"
          ]
        },
        "workerModel": {
          "type": "string",
          "description": "Default worker model name resolved through file, environment, and flag precedence.",
          "examples": [
            "claude-sonnet",
            "gpt-5-codex"
          ]
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "description": "Runtime observability settings loaded from operator configuration before command-line overrides.",
      "properties": {
        "logging": {
          "$ref": "#/$defs/runtimeArtifactSettings",
          "description": "Structured runtime log storage settings. Omitted values use the documented production defaults."
        },
        "metrics": {
          "$ref": "#/$defs/runtimeArtifactSettings",
          "description": "Runtime metrics storage settings. Omitted values use the documented production defaults."
        }
      }
    },
    "workerPresets": {
      "type": "array",
      "description": "Named worker model presets parsed from file only.",
      "examples": [
        [
          {
            "id": "research",
            "modelProvider": "openai",
            "model": "gpt-5.4",
            "reasoningEffort": "high"
          }
        ]
      ],
      "items": {
        "$ref": "#/$defs/workerPreset"
      }
    }
  },
  "$defs": {
    "runtimeArtifactSettings": {
      "type": "object",
      "additionalProperties": false,
      "description": "Rolling-file storage settings for one runtime observability artifact.",
      "properties": {
        "directory": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*",
          "description": "Optional artifact root. Omission uses the runtime-owned directory below the operator home."
        },
        "maxSizeMB": {
          "type": "integer",
          "minimum": 1,
          "default": 100,
          "description": "Maximum artifact file size in megabytes before rotation."
        },
        "maxBackups": {
          "type": "integer",
          "minimum": 1,
          "default": 20,
          "description": "Maximum number of rotated artifact files to retain."
        },
        "maxAgeDays": {
          "type": "integer",
          "minimum": 1,
          "default": 30,
          "description": "Maximum age in days for rotated artifact files."
        },
        "compress": {
          "type": "boolean",
          "default": false,
          "description": "Whether rotated artifact files are gzip-compressed."
        }
      }
    },
    "operatorWorkerModelProvider": {
      "type": "string",
      "pattern": "^[\\t-\\r \u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]*(?:AGY|ANTHROPIC|CLAUDE|CODEX|CURSOR|CURSOR_AGENT|GEMINI|KIRO|OPENAI|OPENCODE|PI|agent|agy|anthropic|antigravity|claude|codex|cursor|cursor-agent|gemini|kiro|kiro-cli|openai|opencode|pi)[\\t-\\r \u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]*$",
      "description": "Required model provider canonicalized to a supported provider after surrounding whitespace is trimmed. Symbolic DEFAULT is rejected in presets."
    },
    "workerPreset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "modelProvider"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*[^\\t-\\r \u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000].*",
          "description": "Required non-empty preset identifier after trim.",
          "examples": [
            "research",
            "fast"
          ]
        },
        "modelProvider": {
          "$ref": "#/$defs/operatorWorkerModelProvider",
          "description": "Required non-empty model provider canonicalized to supported providers.",
          "examples": [
            "openai",
            "claude",
            "codex"
          ]
        },
        "model": {
          "type": "string",
          "description": "Optional model name trimmed when present.",
          "examples": [
            "gpt-5.4",
            "claude-sonnet-4-20250514"
          ]
        },
        "reasoningEffort": {
          "type": "string",
          "pattern": "^[\\t-\\r \u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]*(?:[mM][iI][nN][iI][mM][aA][lL]|[lL][oO][wW]|[mM][eE][dD][iI][uU][mM]|[hH][iI][gG][hH])?[\\t-\\r \u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]*$",
          "description": "Optional reasoning effort level. Surrounding whitespace and letter case are normalized; an empty value is accepted.",
          "examples": [
            "",
            "low",
            "medium",
            "high"
          ]
        }
      }
    },
    "fileOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "owns"
      ],
      "properties": {
        "package": {
          "const": "operator_settings"
        },
        "owns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tolerates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "doesNotOwn": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sharedFileSplit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "owners"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "owners": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/fileOwner"
          }
        }
      }
    },
    "unknownFieldPolicyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "policy"
      ],
      "properties": {
        "package": {
          "const": "operator_settings"
        },
        "policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fieldContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventoryId",
        "jsonPath",
        "documentation",
        "lifecycle",
        "precedence",
        "sensitivity",
        "defaultEmptyBehavior",
        "parseOwner",
        "persistenceOwner",
        "strictness"
      ],
      "properties": {
        "inventoryId": {
          "type": "string",
          "minLength": 1
        },
        "jsonPath": {
          "type": "string",
          "minLength": 1
        },
        "documentation": {
          "$ref": "https://schemas.portpowered.com/you/contracts/common/documentation.schema.json"
        },
        "lifecycle": {
          "$ref": "https://schemas.portpowered.com/you/contracts/common/deprecations.schema.json"
        },
        "precedence": {
          "$ref": "https://schemas.portpowered.com/you/contracts/common/precedence.schema.json"
        },
        "sensitivity": {
          "$ref": "https://schemas.portpowered.com/you/contracts/common/sensitivity.schema.json"
        },
        "defaultEmptyBehavior": {
          "type": "string",
          "minLength": 1
        },
        "parseOwner": {
          "const": "operator_settings"
        },
        "persistenceOwner": {
          "enum": [
            "none",
            "operator_settings"
          ]
        },
        "strictness": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "contract": {
    "formatVersion": "1.0.0",
    "precedenceChain": "file < env < flag",
    "sharedConfigFile": {
      "relativePath": ".you-agent-factory/config.json",
      "resolvedBy": "defaultpaths.OperatorConfigPath(homeDir)"
    },
    "sharedFileSplit": {
      "summary": "operator_settings owns backendScopeID identity, defaults, runtime observability settings, and workerPresets behavior; its focused loaders share one service-owned config file",
      "owners": [
        {
          "package": "operator_settings",
          "owns": [
            "backendScopeID",
            "defaults",
            "defaults.workerModelProvider",
            "defaults.workerModel",
            "runtime",
            "runtime.logging",
            "runtime.logging.directory",
            "runtime.logging.maxSizeMB",
            "runtime.logging.maxBackups",
            "runtime.logging.maxAgeDays",
            "runtime.logging.compress",
            "runtime.metrics",
            "runtime.metrics.directory",
            "runtime.metrics.maxSizeMB",
            "runtime.metrics.maxBackups",
            "runtime.metrics.maxAgeDays",
            "runtime.metrics.compress",
            "workerPresets",
            "workerPresets[].id",
            "workerPresets[].modelProvider",
            "workerPresets[].model",
            "workerPresets[].reasoningEffort"
          ]
        }
      ]
    },
    "unknownFieldPolicy": [
      {
        "package": "operator_settings",
        "policy": "settings and identity loading use the generated GlobalConfig model with json.Decoder.DisallowUnknownFields and reject unknown top-level keys, unknown nested keys, and trailing JSON values"
      }
    ],
    "siblingPreservation": "persistBackendScopeID re-encodes the generated GlobalConfig contract and preserves decoded defaults, runtime observability settings, and workerPresets",
    "fields": {
      "backendScopeID": {
        "inventoryId": "backendScopeID",
        "jsonPath": "backendScopeID",
        "defaultEmptyBehavior": "missing document or missing, empty, or whitespace-only value triggers EnsureLocalBackendScope to generate local-<uuid> and persist it; a present whitespace-only document is invalid",
        "parseOwner": "operator_settings",
        "persistenceOwner": "operator_settings",
        "strictness": "operator_settings generated GlobalConfig strict decode (unknown fields and trailing JSON rejected)",
        "notes": "operator_settings loads identity from the canonical generated GlobalConfig document and persists it by re-encoding modeled fields",
        "documentation": {
          "formatVersion": "1.0.0",
          "itemId": "config.backend-scope-id",
          "documentation": {
            "title": {
              "id": "config.backend-scope-id.title",
              "canonicalEnglish": "Backend scope identifier"
            },
            "description": {
              "id": "config.backend-scope-id.description",
              "canonicalEnglish": "Stable identifier for the local provider-backed runtime boundary. Missing, whitespace-only, or empty values trigger EnsureLocalBackendScope to generate local-<uuid> and persist it through operator_settings."
            }
          },
          "examples": [
            "local-aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee"
          ],
          "visibility": "public",
          "sourceHash": "d84fba3e2ae63115c026f76e7c59e8420f512de2b56f679c87541248dbaf3552"
        },
        "lifecycle": {
          "formatVersion": "1.0.0",
          "itemId": "config.backend-scope-id",
          "state": "active",
          "since": "1.0.0"
        },
        "precedence": {
          "formatVersion": "1.0.0",
          "itemId": "config.backend-scope-id",
          "layers": []
        },
        "sensitivity": {
          "formatVersion": "1.0.0",
          "itemId": "config.backend-scope-id",
          "classification": "public",
          "notes": "Scope identifiers appear in diagnostics without redaction and are not secret material"
        }
      },
      "defaults": {
        "inventoryId": "defaults",
        "jsonPath": "defaults",
        "defaultEmptyBehavior": "missing defaults object yields empty operator defaults",
        "parseOwner": "operator_settings",
        "persistenceOwner": "operator_settings",
        "strictness": "operator_settings generated GlobalConfig strict decode (unknown fields and trailing JSON rejected)",
        "notes": "defaults are parsed before env/flag resolution and preserved when operator_settings persists a generated backend scope",
        "documentation": {
          "formatVersion": "1.0.0",
          "itemId": "config.defaults",
          "documentation": {
            "title": {
              "id": "config.defaults.title",
              "canonicalEnglish": "Operator defaults"
            },
            "description": {
              "id": "config.defaults.description",
              "canonicalEnglish": "File-backed default worker model provider and model resolved through file, environment, and flag precedence layers."
            }
          },
          "examples": [
            {
              "workerModelProvider": "claude",
              "workerModel": "claude-sonnet"
            }
          ],
          "visibility": "public",
          "sourceHash": "8bdd73464dfb1f84fee58b77addb17af535142ce3efec7c7bc692a8dd03234ff"
        },
        "lifecycle": {
          "formatVersion": "1.0.0",
          "itemId": "config.defaults",
          "state": "active",
          "since": "1.0.0"
        },
        "precedence": {
          "formatVersion": "1.0.0",
          "itemId": "config.defaults",
          "layers": [
            "file",
            "env",
            "flag"
          ]
        },
        "sensitivity": {
          "formatVersion": "1.0.0",
          "itemId": "config.defaults",
          "classification": "public"
        }
      },
      "defaults.workerModelProvider": {
        "inventoryId": "defaults.workerModelProvider",
        "jsonPath": "defaults.workerModelProvider",
        "defaultEmptyBehavior": "missing or whitespace-only value is unset until env/flag layers apply; symbolic DEFAULT resolves through lower-precedence concrete provider",
        "parseOwner": "operator_settings",
        "persistenceOwner": "operator_settings",
        "strictness": "operator_settings generated GlobalConfig strict decode (unknown fields and trailing JSON rejected)",
        "notes": "values are trimmed and canonicalized; unsupported providers fail resolve",
        "documentation": {
          "formatVersion": "1.0.0",
          "itemId": "config.defaults.worker-model-provider",
          "documentation": {
            "title": {
              "id": "config.defaults.worker-model-provider.title",
              "canonicalEnglish": "Default worker model provider"
            },
            "description": {
              "id": "config.defaults.worker-model-provider.description",
              "canonicalEnglish": "Default model provider for workers when not overridden per preset or invocation. Values are trimmed and canonicalized; unsupported providers fail resolve. Symbolic DEFAULT resolves through lower-precedence concrete provider."
            }
          },
          "examples": [
            "claude",
            "codex",
            "openai"
          ],
          "visibility": "public",
          "sourceHash": "d75dc9cff096885b6e5925c7a7e4381db6ee5e8e06ae2ee6c797a91cbc617b30"
        },
        "lifecycle": {
