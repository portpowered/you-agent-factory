{
  "name":"@you/plan-execute",
  "id":"builtin-plan-execute",
  "description":{"type":"LOCALIZABLE_ASSET","value":"Writes a Markdown and JSON PRD, prepares an isolated worktree, and executes the PRD through implementation, review, CI, and merge."},
  "invocationReturn":{"policy":"EXPLICIT","workTypeName":"idea","terminalState":"complete"},
  "invocationSignature":{"parameters":[
    {"name":"request","description":"Project request to plan and deliver.","externalName":"to","required":true,"bindings":[{"kind":"POSITIONAL","position":1},{"kind":"STDIN"},{"kind":"NAMED"}]},
    {"name":"branchName","description":"Safe branch and worktree identity.","externalName":"branch-name","bindings":[{"kind":"NAMED"}]},
    {"name":"plannerProvider","description":"Model provider for planning and review; omitted values use operator defaults.","externalName":"planner-provider","defaultValues":[""],"bindings":[{"kind":"NAMED"}]},
    {"name":"plannerModel","description":"Model for planning and review; omitted values use operator defaults.","externalName":"planner-model","defaultValues":[""],"bindings":[{"kind":"NAMED"}]},
    {"name":"executorProvider","description":"Model provider for implementation; omitted values use operator defaults.","externalName":"executor-provider","defaultValues":[""],"bindings":[{"kind":"NAMED"}]},
    {"name":"executorModel","description":"Model for implementation; omitted values use operator defaults.","externalName":"executor-model","defaultValues":[""],"bindings":[{"kind":"NAMED"}]},
    {"name":"reviewerProvider","description":"Model provider for final review; omitted values use operator defaults.","externalName":"reviewer-provider","defaultValues":[""],"bindings":[{"kind":"NAMED"}]},
    {"name":"reviewerModel","description":"Model for final review; omitted values use operator defaults.","externalName":"reviewer-model","defaultValues":[""],"bindings":[{"kind":"NAMED"}]}
  ]},
  "examples":[{"name":"deliver-feature","description":{"type":"LOCALIZABLE_ASSET","value":"Plan and deliver a feature through an isolated worktree."},"args":{"request":"Implement and verify the requested feature"}}],
  "resources":[{"name":"delivery-slots","capacity":8},{"name":"planner-slot","capacity":1}],
  "workTypes":[
    {"name":"idea","handlingBehavior":["DEFAULT"],"states":[{"name":"init","type":"INITIAL"},{"name":"to-complete","type":"PROCESSING"},{"name":"complete","type":"TERMINAL"},{"name":"failed","type":"FAILED"}]},
    {"name":"plan","states":[{"name":"init","type":"INITIAL"},{"name":"complete","type":"TERMINAL"},{"name":"failed","type":"FAILED"}]},
    {"name":"task","states":[{"name":"init","type":"INITIAL"},{"name":"in-review","type":"PROCESSING"},{"name":"to-complete","type":"PROCESSING"},{"name":"complete","type":"TERMINAL"},{"name":"failed","type":"FAILED"}]},
    {"name":"review","states":[{"name":"init","type":"INITIAL"},{"name":"complete","type":"TERMINAL"},{"name":"failed","type":"FAILED"}]}
  ],
  "workers":[
    {"name":"prd-planner","type":"AGENT_WORKER","modelProvider":"${plannerProvider}","model":"${plannerModel}","skipPermissions":true,"stopToken":"<COMPLETE>","promptFile":"prompts/planner.md"},
    {"name":"workspace-setup","type":"SCRIPT_WORKER","command":"python","args":["factory/scripts/setup-workspace.py","{{ (index .Inputs 0).Name }}","${branchName}"]},
    {"name":"prd-executor","type":"AGENT_WORKER","modelProvider":"${executorProvider}","model":"${executorModel}","skipPermissions":true,"stopToken":"<COMPLETE>","promptFile":"prompts/executor.md"},
    {"name":"prd-reviewer","type":"AGENT_WORKER","modelProvider":"${reviewerProvider}","model":"${reviewerModel}","skipPermissions":true,"stopToken":"<COMPLETE>","promptFile":"prompts/reviewer.md"}
  ],
  "workstations":[
    {"name":"plan-prd","type":"AGENT_RUN","worker":"prd-planner","resources":[{"name":"planner-slot","capacity":1}],"workPropagation":{"mode":"PRESERVE_INPUT"},"inputs":[{"workType":"idea","state":"init"}],"outputs":[{"workType":"idea","state":"to-complete"},{"workType":"plan","state":"init"}],"onFailure":[{"workType":"idea","state":"failed"}],"promptFile":"prompts/planner.md"},
    {"name":"setup-workspace","type":"SCRIPT_RUN","worker":"workspace-setup","inputs":[{"workType":"plan","state":"init"}],"outputs":[{"workType":"plan","state":"complete"},{"workType":"task","state":"init"}],"onFailure":[{"workType":"plan","state":"failed"}]},
    {"name":"process-prd-story","type":"AGENT_RUN","behavior":"REPEATER","worker":"prd-executor","resources":[{"name":"delivery-slots","capacity":1}],"workingDirectory":".claude/worktrees/{{ (index .Inputs 0).Name }}","inputs":[{"workType":"task","state":"init"}],"outputs":[{"workType":"task","state":"in-review"},{"workType":"review","state":"init"}],"onContinue":[{"workType":"task","state":"init"}],"onRejection":[{"workType":"task","state":"init"}],"onFailure":[{"workType":"task","state":"failed"}],"promptFile":"prompts/executor.md"},
    {"name":"review-prd","type":"AGENT_RUN","worker":"prd-reviewer","resources":[{"name":"delivery-slots","capacity":1}],"workingDirectory":".claude/worktrees/{{ (index .Inputs 0).Name }}","inputs":[{"workType":"task","state":"in-review"},{"workType":"review","state":"init"}],"outputs":[{"workType":"task","state":"to-complete"},{"workType":"review","state":"complete"}],"onRejection":[{"workType":"task","state":"init"}],"onFailure":[{"workType":"task","state":"failed"},{"workType":"review","state":"failed"}],"promptFile":"prompts/reviewer.md"},
    {"name":"complete-delivery","type":"LOGICAL_MOVE","inputs":[{"workType":"idea","state":"to-complete","guards":[{"type":"SAME_NAME","matchInput":"task"}]},{"workType":"task","state":"to-complete"}],"outputs":[{"workType":"idea","state":"complete"},{"workType":"task","state":"complete"}]},
    {"name":"executor-loop-breaker","type":"LOGICAL_MOVE","guards":[{"type":"VISIT_COUNT","workstation":"process-prd-story","maxVisits":50}],"inputs":[{"workType":"task","state":"init"}],"outputs":[{"workType":"task","state":"failed"}]},
    {"name":"review-loop-breaker","type":"LOGICAL_MOVE","guards":[{"type":"VISIT_COUNT","workstation":"review-prd","maxVisits":10}],"inputs":[{"workType":"task","state":"in-review"}],"outputs":[{"workType":"task","state":"failed"}]}
  ]
}
