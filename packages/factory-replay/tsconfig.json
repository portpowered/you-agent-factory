{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "exactOptionalPropertyTypes": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "paths": {
      "@you-agent-factory/client": ["../client/src/index.ts"]
    },
    "strict": true,
    "target": "ES2022"
  },
  "include": ["src/**/*.d.ts", "src/**/*.js", "test/**/*.ts"]
}
